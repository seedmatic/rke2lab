<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>ghapp-edge</artifactId>
  <name>osgi/domains/ghapp/ghapp-edge</name>
  <description>The live ghapp edge: one @Component over the JDK — GithubAppTokenMinter satisfies
    GithubAppMinter (sign the App JWT, POST a scoped installation token). BouncyCastle reads the PEM;
    the JDK HttpClient calls GitHub. Tagged rke2lab.gardening=cultivating so survey/preview filters it
    out. (Declaration of the App is host-side, in the standalone ghapp CLI — not an edge.)</description>

  <dependencies>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ghapp-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- PEM read (bcpkix: PEMParser + JcaPEMKeyConverter) over the provider (bcprov). First-class BC
         bundles, provided scope — installed as their own bundles, org.bouncycastle.* Import-Package. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- bnd-consumed: @Component generates OSGI-INF/*.xml + the Service-Component header -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
