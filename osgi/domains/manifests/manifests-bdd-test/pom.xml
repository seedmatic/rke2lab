<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-test-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-test-parent/pom.xml</relativePath>
  </parent>

  <artifactId>manifests-bdd-test</artifactId>
  <name>osgi/domains/manifests/manifests-bdd-test</name>
  <description>The -test fragment of manifests-bdd: a Fragment-Host attached to the manifests-bdd
    bundle, sharing its classloader so its passenger runs IN-CONTAINER and the RunGate it registers
    is the SAME Class the scenario resolves. Unlike bbox-bdd-test (which mocks everything), the
    manifests scion resolves the REAL synthesis: manifests-core's DS @Components
    (ManifestSynthesisService, NodeEnvOverlayService) activate under SCR and the scenario drives
    them, so this proof pulls manifests-core's whole runtime graph (the cdk8s carrier + systemd
    fragment) in-container — the same graph ManifestsCoreInContainerTest resolves. The passenger
    registers only the mock RunGate (the one collaborator the host, not SCR, publishes in prod),
    plays the scenario through ManifestsBddScenarios.run(facet) with a known facet, and asserts on
    the harvested RunbookEnvelope: the synthesis produced the enabled domains and the runbook plays
    green — the control-plane policy genuinely reactivated inside synthesis.</description>

  <dependencies>
    <!-- The host under test: the scenario + the front-door. provided — the fragment is pure test
         bytecode that resolves against the manifests-bdd host at runtime. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-bdd</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The vocabulary the facet + assertions speak: the runbook-input wire-record, the synthesis
         result, the domain catalog. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-contract</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- ServerManifestsCoordinate — the passenger checks whether the render filed the node-bootstrap
         bundle. provided: it rides the manifests-bdd host's import of the ingress contract. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-ingress-contract</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- NdhKeystoreReader — the synthesis now binds it (mandatory); the passenger registers an
         absent-keystore stub. provided: the interface rides the staged ndh-contract bundle (pulled
         into the bench by manifests-core's import), the stub is the only impl the test publishes. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ndh-contract</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The frontier vocabulary: the RunGate the passenger mocks + registers, the SeedEnvelope the
         trigger rides, the codec that reads the harvested runbook. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- the passenger decodes the harvested RunbookEnvelope with jackson. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- The generic in-container runner the fragment's entry delegates to (JUnitLauncherCore /
         InContainerJUnitRunner). Provided — resolved through the manifests-bdd host at runtime. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- the fragment's src/main entry names framework types + the in-container runner directly;
         provided — resolved through the manifests-bdd host at runtime. -->
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.framework</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>junit-launcher</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Jupiter, the engine, jgiven-junit5, junit-platform-launcher are inherited from
         bundle-test-parent. osgi.core (test): the passenger + proxy name framework types directly. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- the src/test @OsgiWorld proxy boots Felix via JGivenTestkit.felix() and installs the JUnit +
         jGiven bundle worlds by classpath substring, so they must be on the TEST classpath. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>scenario-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>jgiven-wrap</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- victools-wrap on the test classpath so installImportClosureOf can install it: manifests-core
         (via seed-broker-shape's RecordSchemaProjector) imports com.github.victools.*, whose only
         exporter is this wrap bundle. The closure walk locates bundles by classpath; without this
         the whole synthesis graph fails to resolve. The jgiven-wrap treatment, for the shape engine. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>victools-wrap</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- manifests-core's whole runtime graph on the test classpath so installImportClosureOf can
         install it (provided-scope manifests-bdd is not transitive): the cdk8s carrier + the systemd
         fragment that rides it, the sibling ports, unitrepo-core, the jackson stack, ipaddress. The
         same graph manifests-core-test declares — the scion drives the REAL synthesis, so it needs
         all of it in-container. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-cdk8s</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>unitrepo-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>netplan-contract</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- RenderDeliveryTest drives the render's delivery end to end OUT of the container, on real parts:
         the jgit heads (worktree-core), the real sops (sops-edge) and jgit to read the local bare. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>worktree-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>sops-edge</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.seancfoley</groupId>
      <artifactId>ipaddress</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
