<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>build-parent</artifactId>
    <version>0.0.0</version>
    <relativePath>../../../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>framework-launcher</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <name>osgi/runtime/framework-launcher</name>
  <description>Production OSGi runtime host: boots an embedded Felix framework + felix.scr inside an
    exec entrypoint, derives system.packages.extra from the embedded bundles' own manifests, installs
    and starts them, and exposes the BundleContext so the host seam reads services from the registry.
    The runtime-side counterpart of osgi/testkit. Not a bundle.</description>

  <!--
    Kept in src/main/java (not a bundle): this is host-world infrastructure consumed flat by the
    exec entrypoints (seed-outcluster today, the CLIs later), the same shape as osgi/testkit serving the
    tests. It boots Felix, so felix.framework + osgi.core are compile deps; felix.scr is a compile
    dep so the runtime can locate its jar to install it as the DS extender bundle.
  -->
  <dependencies>
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.framework</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- The boot's host-side logging convergence (HostLoggingBridge + FelixJulLogger), SHARED with
         the test executor so prod and test wire host logs identically. Pax-free — it carries no
         second slf4j binding — so it does not disturb the pax LogService configured below for the
         OSGi side. The launcher calls HostLoggingBridge.install() + passes a FelixJulLogger. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>boot-logging</artifactId>
    </dependency>
    <!-- The shared boot MODEL: the embed capability, the BootStackJar registry, and the
         ClasspathBundleIndex this executor consumes to locate bundles + mirror their imports before
         the framework exists. Same model the test OutOfContainerFrameworkExtension reads. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>boot-discovery</artifactId>
    </dependency>
    <!-- FrameworkLauncher + BootPipeline name the boot-stack jars via the BootStackJar registry (the
         start-level layering). It would arrive transitively through boot-discovery, but we compile
         against the type, so it is a direct dependency. A RELEASE coordinate like in boot-discovery. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>bnd-read</artifactId>
    </dependency>
    <!--
      The Felix DS extender + the DS-runtime API it imports are RUNTIME concerns of the boot, not
      compile deps: the launcher only locates felix.scr's jar by name and the system bundle exports
      the API packages flat (it does not compile against them).

      optional=true: these are BUNDLES — they belong on a Bundle ClassLoader inside Felix, never on
      the flat host JCL. optional keeps them off every exec module's transitive classpath (Maven does
      not propagate optional deps), which is the seam law made declarative: a staged bundle is absent
      from the JCL by NATURE. The build-time staging extension re-resolves them by coordinate (the
      BootStackJar registry) and copies them under META-INF/bundles, so the boot still finds them —
      they are staged, not flat. See the bundle-on-jcl-is-wrong-classpath invariant.
    -->
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.scr</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.promise</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.function</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <!--
      Pax Logging: the boot installs pax-logging-api (provides org.slf4j to bundles) + pax-logging-
      logback (OSGi LogService impl, reuses the host logback context). Same optional rationale: a
      second org.slf4j provider must NEVER reach the host JCL (it broke jGiven in-container slf4j
      binding) — pax is staged into the framework, never flat. The launcher locates the jars by name
      and installs them as bundles; it does not compile against them.
    -->
    <dependency>
      <groupId>org.ops4j.pax.logging</groupId>
      <artifactId>pax-logging-api</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.ops4j.pax.logging</groupId>
      <artifactId>pax-logging-logback</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
