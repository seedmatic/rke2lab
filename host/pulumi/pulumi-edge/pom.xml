<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>host-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../host-parent/pom.xml</relativePath>
  </parent>

  <artifactId>pulumi-edge</artifactId>
  <name>host/pulumu/pulumi-edge</name>
  <description>The Pulumi external edge: the single host-side home for every contact with the Pulumi
    state backend and Automation API, mutualised across all domains. Holds the low-level
    StackHandle/StackHistory/StackSnapshot/StackCheckpoint over the file backend, and the
    implementations of the doctor ports both faces cross — StackHandleSnapshotSource (ingress, reads
    the timeline) and PulumiInterventionLedgerWriter (egress, writes the ledger). Non-playable
    (com.pulumi.* is native + ServiceLoader), so it stays in the host world; callers cross through
    the ports and never depend on this module directly.</description>

  <dependencies>
    <!-- The journals carry seed-broker seam types directly (Document, Patient, Coordinate, Domain,
         SeedBrokerCatalog): the host produces opaque visit/intervention Documents that only OSGi
         deserializes. Declared explicitly since pulumi-edge names these types itself, not just
         transitively through doctor-contract. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- The document codec: the journals build/read seam Documents through the typed wire-contract
         (VisitWire, …) rather than hand-rolled jackson trees. Shaded flat into the host classpath,
         binding to the host's flat jackson (the same source is nested OSGi-side). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pulumi</groupId>
      <artifactId>pulumi</artifactId>
    </dependency>
    <!-- junit as RUNTIME code (not test): PulumiDeploymentSeed is a Jupiter extension the host
         registers on the root scenario to install the live Deployment on the launcher worker thread
         — the same "launcher is the engine, not a test tool" posture as seed-outcluster's jgiven-junit5.
         jupiter-api for the BeforeEachCallback/ExtensionContext side; platform-engine for the
         session-store seeding side (NamespacedHierarchicalStore/Namespace), as scenario-engine's
         RunRoleSeed/TxIdSeed use. Compile scope: the extension ships in the host runtime. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
</project>
