-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.fabric.contract
Export-Package: io.seedmatic.rke2lab.fabric.contract
# type=contract — the fabric domain's delivery vocabulary (FabricDelivery's branch + file names, the
# runbook-input wire-record, the domain coordinates). Installed bundle-side and wired
# bundle-to-bundle, NOT system-exported: the host speaks only to the broker, and the fabric scion
# imports this package in-container. The contract-purity guard fails the build if this bundle
# exports a concrete class.
Provide-Capability: io.seedmatic.rke2lab.embed; type=contract
