<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>cluster-pki-core</artifactId>
  <name>osgi/domains/cluster-pki/cluster-pki-core</name>
  <description>The deterministic cluster CA-hierarchy generator, pure BouncyCastle: given the ndh
    mammoth-skate-tls root (cert + key, PEM or OpenSSH), it mints the rke2 bring-your-own-CA set — an
    intermediate (RSA 4096) signed by the root, the five leaf CAs (client/server/request-header/
    etcd-peer/etcd-server, EC prime256v1) signed by the intermediate, and the service-account issuer
    key (RSA 2048) — each leaf .crt the full chain, each leaf key SEC1, service.key PKCS#1. A faithful
    Java port of k3s contrib/generate-custom-ca-certs.sh (proven structurally identical cert-by-cert
    against OpenSSL 3). type=model — installed as a native bundle; BouncyCastle rides as its own OSGi
    bundles (Import-Package org.bouncycastle.*), staged beside it.</description>

  <dependencies>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>
    <!-- The domain contract: the seal's output records (ClusterCaBundle, ClusterAgeKey) + the
         SopsEncryptor seam it drives. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>cluster-pki-contract</artifactId>
    </dependency>
    <!-- The ssh-to-age seam: ClusterSeal derives the cluster age IDENTITY from the rke2-cluster SSH
         key (the same conversion SopsAgeMaterialResolver uses), realised by ssh-to-age-edge. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-contract</artifactId>
    </dependency>
    <!-- The ndh keystore reader seam: ClusterSeal reads the mammoth-skate-tls root + rke2-cluster
         key through it (the single reader, realised by ndh-core). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ndh-contract</artifactId>
    </dependency>
    <!-- Read keys.yaml + .sops.yaml (structured YAML, no regex) and render the 11-key bundle YAML. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <!-- The CA-hierarchy generator (bcpkix: cert builders + PEM I/O) + the OpenSSH/PEM root-key
         reader (bcutil: OpenSSHPrivateKeyUtil) over the provider (bcprov). BC 1.85 carries its own
         Bundle-SymbolicName + OSGi headers, so it is a FIRST-CLASS bundle: scope provided (on the
         compile classpath here, installed as its OWN bundle in the runtime — the third-party-BSN
         staging path, like jgiven's guava/gson), and org.bouncycastle.* is Import-Package, never
         embedded. Version-less: the bc-jdk18on-bom (bom/pom.xml) keeps the three in step. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcutil-jdk18on</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
