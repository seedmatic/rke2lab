#!/usr/bin/env bash
# Every step traced with its time, so the operator sees what runs and what waits (the operator, 2026-10-28): bash's
# own clock, since a fork per traced line costs minutes on a big commit, and each guard's per-file loop untraced
# (`untraced`), so a step shows once, not once per staged file.
export PS4='+ ${EPOCHREALTIME%.*} ${BASH_SOURCE##*/}:${LINENO}: '
set -euxo pipefail

cd "$(git rev-parse --show-toplevel)"

# Refuse to commit secret material in the clear.
#
# Checks the STAGED BLOB, never the worktree. In a repository whose .gitattributes
# runs the sops clean filter, the worktree copy is legitimately plaintext and only
# the blob is encrypted — so a worktree check would fire on every commit while
# missing the one case that matters: a blob that escaped the filter.
#
# The pattern is written with its literal broken (PRIVATE[ ]KEY) so this file does
# not match itself. A scanner that carries its own signatures flags itself and every
# document that mentions them.
#
# That case is not hypothetical. Eight SSH private keys sat in the clear in a
# public repository from 2026-08-27 to 2026-10-04, in a file carrying a VALID sops
# envelope with an empty payload, because a Kubernetes creation_rule matched it
# first and its encrypted_regex matched none of its fields. Neither the filter nor
# an eval-time assertion could see it: one saw an envelope, the other asked whether
# the file "looks decrypted". The question has to be whether secret material is
# still readable.
# Runs "$@" with the trace off, and restores it: for the guards' per-file loops.
untraced() {
  { local was=$-; set +x; } 2>/dev/null
  local rc=0
  "$@" || rc=$?
  [[ $was == *x* ]] && set -x
  return "$rc"
}

secret_material_guard() {
  local found=0 f blob
  while IFS= read -r -d '' f; do
    blob="$(git ls-files -s -- "$f" | awk '{print $2}')"
    [[ -n "$blob" ]] || continue
    # A header alone is a MENTION — schemas, specs and docs legitimately name these
    # blocks. Real material has a header AND a body, so require a long base64 line
    # within two lines of the header. Without that distinction the guard fires on
    # its own documentation and gets switched off within a week.
    if git cat-file blob "$blob" 2>/dev/null | awk '
        /BEGIN [A-Z]*[ ]?PRIVATE[ ]KEY/ { hdr = NR }
        hdr && NR > hdr && NR <= hdr + 2 && /^[A-Za-z0-9+\/=]{40,}$/ { found = 1; exit }
        /AGE-SECRET[-]KEY-1[A-Z0-9]{50,}/ { found = 1; exit }
        END { exit(found ? 0 : 1) }
      '; then
      echo "  ⛔ $f — staged blob contains private key material in the clear" >&2
      found=1
    fi
  done < <(git diff --cached --name-only --diff-filter=ACMRT -z)

  if ((found)); then
    cat >&2 <<'EOF'

Refusing the commit. One of the staged blobs carries a private key or an age
secret in the clear.

If the file is meant to be sops-encrypted, the encryption did not happen. Check
which creation_rule .sops.yaml applied to it — a rule whose encrypted_regex
matches none of the file's fields still produces a complete, valid envelope around
an unencrypted payload.

Verify with the same question this guard asks, which is about content and not
about the envelope:

  git show :<path> | grep -c 'BEGIN OPENSSH'

EOF
    return 1
  fi
  return 0
}

# Refuse a bearer token in the clear inside a sops-managed file.
#
# The private-key guard above reads key MARKERS; a bearer token has none. A FloxHub
# JWT sat in the clear in .secrets from 2026-09-09 to 2026-10-11: its leaf carried no
# `# sops:encrypted` comment, so encrypted_comment_regex skipped it, and the envelope
# around it was valid. So here the question is the shape of what is left once every
# ENC[…] value is removed: a JWT (three base64url segments, the first two starting
# with a JSON object) or a known token prefix.
#
# Scoped to sops-managed files — those the sops filter cleans, or whose blob holds an
# ENC[ value — because those are the files that claim to hold secrets. Elsewhere a
# token prefix is a mention, and docs mention them. A repository with no .sops.yaml
# has no place for a secret at all, so there EVERY file is in scope: a vendored-env
# repository such as fleet reaches its consumers by `git subtree pull`, a merge no
# pre-commit sees.
# The offending LINE NUMBERS are printed, never the line: the value is the secret.
token_shape_guard() {
  local found=0 f blob filter lines all=0
  git cat-file -e :.sops.yaml 2>/dev/null || all=1
  while IFS= read -r -d '' f; do
    blob="$(git ls-files -s -- "$f" | awk '{print $2}')"
    [[ -n "$blob" ]] || continue
    filter="$(git check-attr filter -- "$f" | sed 's/.*: filter: //')"
    # Not `cat-file | grep -q`: under pipefail, grep -q exiting early SIGPIPEs cat-file,
    # and the negated pipeline would then skip the very file that matched.
    if ((!all)) && [[ "$filter" != sops* ]] && ! grep -q 'ENC\[' < <(git cat-file blob "$blob"); then
      continue
    fi
    lines="$(git cat-file blob "$blob" 2>/dev/null |
      sed 's/ENC\[[^]]*\]//g' |
      grep -nE 'eyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]+|(tskey-|gh[opsu]_|github_pat_|dckr_pat_|glpat-|flox_pat_)[A-Za-z0-9_-]{16,}' |
      cut -d: -f1 | paste -sd, - || true)"
    if [[ -n "$lines" ]]; then
      echo "  ⛔ $f — staged blob holds a token in the clear outside ENC[…], line(s) $lines" >&2
      found=1
    fi
  done < <(git diff --cached --name-only --diff-filter=ACMRT -z)

  if ((found)); then
    cat >&2 <<'EOF'

Refusing the commit. A staged file carries a bearer token (a JWT or a
tskey-/gh*_/github_pat_/dckr_pat_/glpat-/flox_pat_ token) in the clear. In a repository
without .sops.yaml no file may hold one: move it out of the repository.

In a sops-managed file: with encrypted_comment_regex, sops encrypts only the
leaves whose comment says so, so a leaf without its `# sops:encrypted` marker
stays plaintext inside a valid envelope. Add the marker and re-encrypt — or, if
the token is no longer used, remove the leaf with `sops unset`.

EOF
    return 1
  fi
  return 0
}

# Refuse a sops file that carries a secret-NAMED leaf in the clear, whatever its value looks like.
#
# The shape guard above knows token prefixes; a token of a provider it does not list passes it. The FloxHub token of
# 2026-10-28 did: `sops set` wrote it without the `# sops:encrypted` marker the opt-in rule needed. So this asks the
# other question, about the KEY: in a staged blob with a top-level `sops:` envelope, a scalar outside that envelope
# that is not ENC[…], under a key whose words say secret (token, password, key…), refuses. A key ending in a word that
# says it is a reference (…Name, …Id, …File, …Path, …Dir) is not one. The key PATHS are printed, never a value.
clear_secret_leaf_guard() {
  local found=0 f blob hits
  while IFS= read -r -d '' f; do
    blob="$(git ls-files -s -- "$f" | awk '{print $2}')"
    [[ -n "$blob" ]] || continue
    grep -q '^sops:' < <(git cat-file blob "$blob") || continue
    hits="$(git cat-file blob "$blob" | yq -p yaml -o tsv '
      del(.sops) | .. | select(tag != "!!map" and tag != "!!seq")
        | select((tag == "!!str" and test("^ENC\\[") | not) and tag != "!!null" and tag != "!!bool")
        | path | map(tostring) | join(".")' 2>/dev/null |
      awk -F. '{
        k = $NF; if (k ~ /^[0-9]+$/ && NF > 1) k = $(NF - 1)
        n = k; gsub(/[A-Z]/, " &", n); n = tolower(n); gsub(/[^a-z0-9]+/, " ", n)
        if (n ~ /(^| )(name|id|file|path|dir)$/) next
        if (n ~ /(^| )(token|tokens|secret|secrets|password|passwd|pw|pat|key|apikey|auth|jwt|cookie|credential|credentials|private|priv|bearer|otp|sk)( |$)/) print $0
      }' | paste -sd, - || true)"
    if [[ -n "$hits" ]]; then
      echo "  ⛔ $f — a secret-named leaf is in the clear: $hits" >&2
      found=1
    fi
  done < <(git diff --cached --name-only --diff-filter=ACMRT -z)

  if ((found)); then
    cat >&2 <<'EOF'

Refusing the commit. A sops-managed file has a leaf whose NAME says it is a secret,
in the clear. Encrypt it: in .secrets every value is encrypted unless .sops.yaml's
unencrypted_regex names it, so re-run `sops -e -i --input-type yaml --output-type yaml
.secrets` from your own terminal; elsewhere add its `# sops:encrypted` marker first.

EOF
    return 1
  fi
  return 0
}

# Refuse a staged file that spotless would reformat.
#
# The build does not format any more (it rewrote shared worktrees behind their sessions' back: a javadoc reflow
# surfaced in someone else's checkout, from a commit that had never been formatted). So the check moves here, onto
# what is about to be committed, and it only CHECKS: fixing is `./mvnw spotless:apply`, by hand.
#
# Only the types spotless governs (build-parent's spotless configuration) trigger Maven, so a commit that touches none
# of them costs nothing. Spotless reads the worktree copy, not the staged blob: a partially staged file is refused,
# because the copy it would judge is not the one being committed.
spotless_check() {
  local f files=() partial=() regex
  { local was=$-; set +x; } 2>/dev/null
  while IFS= read -r -d '' f; do
    case "$f" in
      *.java | */src/main/resources/*.sh | */src/test/resources/*.sh | README.adoc | docs/*.adoc | docs/*.md | pom.xml | */pom.xml) ;;
      *) continue ;;
    esac
    files+=("$f")
    git diff --quiet -- "$f" || partial+=("$f")
  done < <(git diff --cached --name-only --diff-filter=ACMR -z)
  [[ $was == *x* ]] && set -x

  ((${#files[@]})) || return 0

  if ((${#partial[@]})); then
    printf '  ⛔ %s — partially staged: spotless would judge the worktree copy, not the staged one\n' "${partial[@]}" >&2
    echo "Stage the whole file, or commit the other hunks separately." >&2
    return 1
  fi
  if ! command -v flox >/dev/null 2>&1; then
    echo "  ⛔ flox not found: the spotless check cannot run, so the commit is refused (a gate that skips is no gate)." >&2
    return 1
  fi

  # Run the check only in the modules that own the staged files (the nearest pom.xml): the root aggregator carries no
  # spotless configuration, so a reactor-wide run fails there on any commit. A file owned by the root is not governed.
  local d modules=() owned=()
  { was=$-; set +x; } 2>/dev/null
  for f in "${files[@]}"; do
    d="$(dirname "$f")"
    while [[ "$d" != . && ! -f "$d/pom.xml" ]]; do d="$(dirname "$d")"; done
    [[ "$d" == . ]] && continue
    # A standalone pom (no parent, no spotless of its own — bom, maven-embed-staging-ext) is outside the reactor's
    # spotless configuration, like the root: `-pl` there fails with "No plugin found for prefix 'spotless'".
    # Elements, not words: bom's comment says "no <parent>".
    if ! grep -Eq '^[[:space:]]*<parent>' "$d/pom.xml" && ! grep -q 'spotless-maven-plugin' "$d/pom.xml"; then
      echo "  spotless: skipped $f (standalone pom $d/pom.xml, outside the reactor's spotless configuration)" >&2
      continue
    fi
    owned+=("$f")
    [[ " ${modules[*]} " == *" $d "* ]] || modules+=("$d")
  done
  [[ $was == *x* ]] && set -x
  ((${#modules[@]})) || return 0

  # spotlessFiles takes comma-separated regexes matched against absolute paths.
  regex="$(for f in "${owned[@]}"; do printf '%s\n' "$PWD/$f"; done |
    sed 's/[][\.*^$()+?{}|]/\\&/g' | paste -sd, -)"
  if ! flox activate -- ./mvnw -pl "$(
    IFS=,
    echo "${modules[*]}"
  )" spotless:check -DspotlessFiles="$regex"; then
    cat >&2 <<'EOF'

Refusing the commit: spotless would reformat a staged file. Format it, stage it, and commit again:

  flox activate -- ./mvnw -q spotless:apply -DspotlessFiles='<absolute path regex>'

EOF
    return 1
  fi
  return 0
}

# Refuse, in a repository that holds a flake, a staged attribute routing a file through a sops filter.
# The global git config defines the sops clean/smudge filters, and their smudge leaves secrets in the clear
# on disk: flake repositories are protected by naming none. Read from the STAGED .gitattributes (any
# depth) by `git check-attr --cached`, so this guard stands alone where the global hooks are absent; the
# global pre-commit also checks the worktree, .git/info/attributes and the global attributes file.
sops_filter_attribute_guard() {
  # A flake at ANY depth: one evaluated from a subdirectory still copies the whole repository.
  [[ -n "$(git ls-files -- flake.nix ':(glob)**/flake.nix')" ]] || return 0
  local hits
  hits="$(git ls-files -z | git check-attr --cached -z --stdin filter | tr '\0' '\n' | paste - - - |
    awk -F'\t' '$3 ~ /^sops-/ { print "  ⛔ " $1 "  filter=" $3 }')"
  [[ -z "$hits" ]] && return 0
  head -20 <<<"$hits" >&2
  cat >&2 <<'EOF'

Refusing the commit. This repository holds a flake, and a staged .gitattributes routes these files
through a sops filter: its smudge would leave them in the clear on disk. Keep `diff=sops-*` if you
want a decrypted `git diff`, but never `filter=sops-*` here.

EOF
  return 1
}

status=0
untraced secret_material_guard || status=1
untraced token_shape_guard || status=1
untraced clear_secret_leaf_guard || status=1
sops_filter_attribute_guard || status=1
spotless_check || status=1
exit "$status"
