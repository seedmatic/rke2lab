<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>doctor-core</artifactId>
  <name>osgi/domains/doctor/doctor-core</name>
  <description>The doctor diagnostic model: the pure operator-runbook types (symptom, observation,
    assessment, prescription, remediation plan, medical record, health system, the specialists and
    the clinical-access model) lifted from exec/seed-master into the OSGi world. Consumes the
    doctor-contract observation seam; the host implements it (DIP). Zero pulumi — the rendering engine and
    the live-observation adapters stay host.</description>

  <dependencies>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>doctor-spi</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>doctor-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- The gateway document codec: a dual-realm library bundle (embed; type=dual-realm). doctor-core
         IMPORTS its package (bnd emits Import-Package from the DocumentCodec usage), binding to the
         OSGi jackson. The SAME bundle is kept flat in seed-master's uber-jar, binding the host
         jackson — one source, two realm copies, jackson's own treatment. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>
    <!-- jackson as a real bundle dependency: the gateway seam carries a serialized JSON String, so
         doctor-core parses/serializes it with ITS OWN jackson rather than borrowing the seam's
         (the seam now carries none). This is jackson entering the OSGi world via a bundle wire, not
         leaking flat across the seam — the fix for the in-container LinkageError. jackson-core is a
         direct dependency too (JsonProcessingException is imported directly, not transitively). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- The systemd domain's unit vocabulary: the dbus-tcp specialist names the unit it remediates
         via the typed SystemdUnitId, not a literal — the import draws the consumer edge in the graph. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>systemd-contract</artifactId>
    </dependency>
    <!-- bnd-consumed construction annotations: DefaultHealthSystem (@Component) collects the
         tier-scoped @Reference List<Specialist> and is published as the HealthSystem port service. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- checker-qual: @MonotonicNonNull for the set-once builder field. Analysis-only. -->
    <dependency>
      <groupId>org.checkerframework</groupId>
      <artifactId>checker-qual</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
