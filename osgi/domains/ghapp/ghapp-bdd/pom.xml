<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>ghapp-bdd</artifactId>
  <name>osgi/domains/ghapp/ghapp-bdd</name>
  <description>The ghapp scion: the in-container @SeedScenario the grow sows to make the one org-owned
    GitHub App's credentials available to the run. A pure rehydrate — cellar hit (idempotent-keep) or
    rehydrate from the .secrets githubApp block (via the read-only SecretsGateway), sealing the
    resolved GithubAppCredentials at GhAppCoordinate.GITHUB_APP. It does NOT declare the App: that
    out-of-band ceremony (create / install / seed .secrets) is the standalone `ghapp` CLI, kept out of
    the pulumi-driven grow. GithubAppRunbookHandler is the broker's host-to-scion door (no input).</description>

  <dependencies>
    <!-- GithubAppCredentials / GhAppCoordinate (the sealed case + coordinate). -->
    <!-- FunnelCertIssuance: the ONE declared Let's Encrypt posture. The webhook's insecure_ssl must
         match it (a staging funnel cert is untrusted), so this scenario reads the same enum the
         tailscale render does — the pair cannot be half-flipped. The dual-realm manifests.ingress face
         is already this domain's vocabulary: PacWebhookFunnel, which builds the very url reconciled
         here, lives there too. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-ingress-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ghapp-contract</artifactId>
    </dependency>
    <!-- Map the .secrets JSON subtree (via SecretsGateway) to/from GithubAppCredentials in-container. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Cellar / Parcel / SeedCoordinate / RunbookCoordinate / SeedHandler / Sensitivity / SeedEnvelope
         / AmendCoordinate / AmendmentAssembler. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- SeedCodec + AmendmentBinder: the webhook amend reflector binds the FUNNEL role onto the
         WebhookReconcileInput, and the runbook handler decodes the reconciled trigger. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>
    <!-- GenericRunbookHandler, ScenarioPlayer, @SeedScenario, CellarReceiver, ScenarioCellar, OsgiService. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- bnd-consumed: @Component generates OSGI-INF/*.xml + the Service-Component header. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
