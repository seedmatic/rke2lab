-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.clusterpki.contract
Export-Package: io.seedmatic.rke2lab.clusterpki.contract
# type=dual-realm — the cluster-pki domain's contract lives in BOTH realms: the seal scion (OSGi)
# files ClusterCaBundle + ClusterAgeKey in the cellar, and the pure-host GROW (outside Felix) fetches
# and decodes them via the dual-realm codec. Like incus-ingress-contract / seed-broker-codec it is
# staged as a bundle OSGi-side AND kept flat host-side, so its exported package legitimately lives in
# two realms and DUPLICATE_REALM_CLASS exempts it. Every exported type depends only on the JDK + the
# seed-broker seam (provided, never embedded) — the SopsEncryptor seam is a JDK-only interface, so it
# rides here too (consumer-owned; its impl is the top-level sops-edge). No @Component, so it does NOT Require the SCR extender.
Provide-Capability: io.seedmatic.rke2lab.embed; type=dual-realm
