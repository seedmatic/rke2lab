<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>cluster-edge</artifactId>
  <name>osgi/domains/cluster/cluster-edge</name>
  <description>The cluster external edge: the single door toward the live RKE2 cluster's kube-apiserver.
    It @Component-provides the cluster domain's ClusterReadinessContact seam (cluster-contract) by
    probing kube-apiserver /readyz and controller rollout through a typed fabric8 KubernetesClient
    over a published kubeconfig — natively TLS-verified against the deterministic PKI's CA, no
    kubectl shell, no insecure-skip. fabric8 is a first-class OSGi bundle (imported, not embedded);
    the JDK HttpClient backend is wired via an explicit factory (no ServiceLoader, which OSGi
    breaks). Stateless, single contact: the host owns the retry loop, timeout, Observation
    projection.</description>

  <dependencies>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>cluster-contract</artifactId>
    </dependency>
    <!-- The connect-retry + two-tier-deadline driver awaitReady runs on. A real OSGi bundle staged
         in-container (Import-Package). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>readiness-await</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- fabric8 Kubernetes client: the typed door to kube-apiserver. provided — it carries its own
         Bundle-SymbolicName + OSGi headers (like BouncyCastle), so io.fabric8.* becomes a plain
         Import-Package computed from the bytecode, and seed-outcluster stages the bundle closure INTACT
         at runtime. NOT embedded. kubernetes-httpclient-jdk gives the JDK-HttpClient backend, wired
         explicitly (KubernetesClientBuilder#withHttpClientFactory) so no cross-bundle ServiceLoader
         lookup is needed. -->
    <dependency>
      <groupId>io.fabric8</groupId>
      <artifactId>kubernetes-client</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.fabric8</groupId>
      <artifactId>kubernetes-httpclient-jdk</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The edge's source names fabric8 model + client-api types directly (KubernetesClient, the
         model DTOs it reads); provided like the client umbrella — imported as bundles at runtime. -->
    <dependency>
      <groupId>io.fabric8</groupId>
      <artifactId>kubernetes-client-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.fabric8</groupId>
      <artifactId>kubernetes-model-core</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- bnd-consumed: @Component generates OSGI-INF/*.xml + the Service-Component header -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- The boot test: OutOfContainerFrameworkExtension boots a real Felix, runs SCR, installs THIS
         edge by its embed capability, and exercises the published contact. Out-of-container, no
         fragment (the seam type is exported; no white-box access needed). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>junit-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The out-of-container framework envelope moved to the runtime engine module (JUnit/jGiven are
         runtime-scope now); the @Osgi tag stays in junit-testkit above. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- junit-jupiter (test) is inherited from build-parent. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- withScr(): felix.scr + the DS-API trio it wires to, bundle-to-bundle, on the test classpath. -->
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.scr</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.promise</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.function</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
