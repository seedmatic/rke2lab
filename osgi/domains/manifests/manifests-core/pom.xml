<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>manifests-core</artifactId>
  <name>osgi/domains/manifests/manifests-core</name>
  <description>The manifests universe: the CDK8s-based Kubernetes manifest units, their domains,
    and the soldered resolver-adapter — pure, declares its ports in the bundle manifest.</description>

  <properties>
    <!--
      Build-time synthesis was removed: the cdk8s synth and explode steps now
      run at pulumi-up time so the runbook policy facet can
      drive FloxDebugPolicy. The Main CLI for ad-hoc synthesis
      (`java -jar … synthesize`) now lives in exec/manifests-cli, which shades
      this core into its -exec jar; pass debug knobs via -D system properties
      on that invocation if needed.
    -->
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
    </dependency>
    <!-- The cdk8s vocabulary (org.cdk8s + software.constructs) comes from the manifests-cdk8s carrier
         bundle, which embeds the flat cdk8s closure and exports those packages. provided: this is a
         build-time compile need only (so bnd computes the Import-Package); at runtime manifests-core
         resolves the packages bundle-to-bundle against the carrier, never host-flat. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-cdk8s</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- bnd-consumed construction annotations: @Component declares the DS descriptor bnd generates
         (geste A only — the runtime stays on ServiceLoader until a later slice). -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-contract</artifactId>
    </dependency>
    <!-- The dual-realm host face carrying ComponentVersions: ManifestSynthesisContext + every unit's
         componentVersions() name it. Declared directly (not leaned on transitively via -contract). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-ingress-contract</artifactId>
    </dependency>
    <!-- The seed-broker seam + the shape engine: manifests contributes its shape reflector (a
         @Component SeedHandler serving ShapeCoordinate("manifests")), decoding via the codec and
         projecting the runbook-input schema via seed-broker-shape's RecordSchemaProjector. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-shape</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>netplan-contract</artifactId>
    </dependency>
    <!-- The dataplan layout SSOT: OpenebsZfsManifestsUnit names its StorageClass pools + the static
         persist PV from DataplanLayout (tank/rke2lab/*), never a hardcoded ZFS path. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>dataplan-contract</artifactId>
    </dependency>
    <!-- The ndh keystore reader seam: SopsAgeMaterialResolver reads the rke2-cluster SSH key through
         it (the single reader, realised by ndh-core), no longer navigating keys.yaml itself. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ndh-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>unitrepo-core</artifactId>
    </dependency>
    <!-- org.osgi.resource (capability graph types used by ManifestsDomainRegistry / VisitOrder).
         Declared explicitly: it previously leaked in transitively via the obsolete org.osgi.core
         that unitrepo-core now excludes. osgi.core 8.0.0 carries the package. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
    </dependency>

    <!-- felix.resolver as the Resolver PROVIDER on the test classpath: the unit tests
         (ManifestsVisitOrderTest, RegistryResolveTest) construct their own ResolverImpl to inject
         into UnitResolver/resolve(Resolver). Production binds it as an OSGi service instead. Same
         osgi.core:5.0.0 exclusion as unitrepo-core (it would shadow osgi.core 8.0.0). -->
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.resolver</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.osgi</groupId>
          <artifactId>org.osgi.core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- checker-qual: @MonotonicNonNull for the set-once pipeline/builder fields. Analysis-only. -->
    <dependency>
      <groupId>org.checkerframework</groupId>
      <artifactId>checker-qual</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <!-- bnd-process (managed by osgi/bundle-parent) generates the OSGi MANIFEST from bnd.bnd +
           the bytecode; the bare reference opts this library bundle in. The jar plugin below
           picks up that manifest via the inherited manifestFile wiring. -->
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>dev.dimlight</groupId>
        <artifactId>shellcheck-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>shellcheck-runtime-scripts</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <sourceDirs>
                <sourceDir>
                  <directory>${project.basedir}/src/main/resources</directory>
                  <includes>
                    <include>**/*.sh</include>
                  </includes>
                </sourceDir>
              </sourceDirs>
              <args>
                <arg>-S</arg>
                <arg>warning</arg>
                <arg>-s</arg>
                <arg>--format=tty</arg>
                <arg>--norc</arg>
              </args>
              <failBuildIfWarnings>false</failBuildIfWarnings>
              <capturedStdoutFileName>@executionId@.stdout</capturedStdoutFileName>
              <capturedStderrFileName>@executionId@.stderr</capturedStderrFileName>
              <binaryResolutionMethod>external</binaryResolutionMethod>
              <externalBinaryPath>${maven.multiModuleProjectDirectory}/.flox/run/aarch64-darwin.rke2lab-run/bin/shellcheck</externalBinaryPath>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>m2e</id>
      <activation>
        <property>
          <name>m2e.version</name>
        </property>
      </activation>
    </profile>
  </profiles>
</project>
