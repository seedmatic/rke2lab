<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>manifests-bdd</artifactId>
  <name>osgi/domains/manifests/manifests-bdd</name>
  <description>The manifests domain's synthesis SCENARIO — a production jGiven scenario played
    IN-CONTAINER by the seeding engine, not a test. It is the fifth scion, on the trio pattern the
    four contact scions share (bbox/incus/systemd/cluster), with the differences its nature forces:
    it SYNTHESIZES + MATERIALIZES files rather than probing a live system, it reads the operator's
    activation choice off the trigger (the others ignore theirs), and it consults no doctor (a
    synthesis failure is a build defect, not a medical symptom). It transposes the projection
    HostSlotManifest.Builder.policy() used to make host-side before the demolition orphaned it:
    it derives ManifestDomainPolicy (the synth-time filter, which layers synthesise) from the
    cluster ROLE (ClusterRole, parsed from the identity) + FloxDebugPolicy from the debug facet,
    drives ManifestSynthesisService.synthesize, and so reactivates the control-plane policy INSIDE
    synthesis, structural to the role. A type=model embeddable bundle whose
    scenario class is non-exported: the launcher plays it by class-selection, the host grafts its
    ScenarioModel. See docs/architecture/osgi/manifests-bdd-spec.adoc.</description>

  <dependencies>
    <!-- The manifests contract: the synthesis/overlay SPIs + the runbook-input wire-record + the
         domain catalog the scenario's translation speaks and resolves from the registry. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-contract</artifactId>
    </dependency>
    <!-- Typed recovery vocabulary: the ScenarioNotReadyError base + SymptomKind the synthesis THEN
         raises (ManifestSynthesisError) so an incomplete synthesis carries a routing symptom. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>doctor-contract</artifactId>
    </dependency>
    <!-- manifests-core: the synthesis-time NodeEnvContext (DefaultNodeEnvContext) the scion hands
         writeControlplaneOverlay — the netplan-derived layer context, self-contained OSGi-side. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-core</artifactId>
    </dependency>
    <!-- The frontier vocabulary: the RunGate the scion consults (cultivate vs survey), the
         SeedEnvelope the trigger arrives on and the runbook is reaped on, the codec that decodes
         the facet. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>
    <!-- The version-bump plant's own collaborators. manifests-ingress-contract carries the pins
         (ComponentVersions.defaults()) the bumper reads/rewrites; the three type=contract domains
         are what the VersionBumpScenario @OsgiService-injects, bundle-side (unreachable to the flat
         host — which is exactly why the bump is a scion): worktree (jgit stage/commit + GitIdentity),
         auth (the GitHub token), ndh (the tailnet authorityDomain the bot email is minted from). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-ingress-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>worktree-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>auth-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ndh-contract</artifactId>
    </dependency>
    <!-- jackson-databind: the bumper reads the GitHub releases JSON directly (ObjectMapper). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- jackson-dataformat-yaml: the render facet is recorded as a human-readable YAML doc at the
         branch root (YAMLMapper); the read side converts it back with `yq -o=json .facet`. bnd's
         trailing `*` auto-imports the package, and snakeyaml is already in the runtime (manifests
         -core ships it). -->
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <!-- jGiven as compile deps: the scenario IS jGiven Stages. At runtime these packages resolve to
         the jgiven-wrap bundle, pulled into the live world by this bundle's import closure. -->
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-core</artifactId>
    </dependency>
    <!-- The scenario's main code declares Jupiter extensions and drives the embedded launcher directly
         (bdd-as-engine), so these are compile deps here, not only test. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
    </dependency>
    <!-- The neutral in-container runner (JUnitLauncherCore) the front-door calls to play the
         scenario inside Felix. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
    </dependency>
    <!-- osgi.core: the scenario resolves its collaborators from the BundleContext (the synthesis
         service, the overlay service, the RunGate), the connection carrying the registry. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- bnd-consumed construction annotations: ManifestsRunbookHandler (@Component) publishes the
         runbook SeedHandler that plays this bundle's scenario in-container. provided — SCR supplies
         the runtime, bnd only needs them to emit the descriptor + the extender requirement. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- checker-qual: @MonotonicNonNull for the scenario's set-once outdir (created on the first
         synthesis beat, read by the overlay beat + the Then). NullAway reads it at compile time;
         provided (analysis-only, nothing resolves it at runtime). -->
    <dependency>
      <groupId>org.checkerframework</groupId>
      <artifactId>checker-qual</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
