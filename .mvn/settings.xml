<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase
  Maven settings for rke2lab.

  Authentication for GitHub Packages (Maven artifacts hosted at
  maven.pkg.github.com).  GitHub Packages requires authentication even
  for *public* packages — see
  https://github.com/orgs/community/discussions/26634 — so the build
  needs a token whether or not the underlying repo is public.

  Convention: one <server> entry per artifact-hosting repo, id matching
  the corresponding <repository> id in the parent pom.xml.  GH Packages
  requires a non-empty username alongside the token, but doesn't
  validate it against the token's owner — any string works; we use a
  literal placeholder.

  Source the token from the GH_TOKEN env var (flox-managed in this
  repo's .flox env; the gh CLI's standard name) so we don't carry a
  PAT in the worktree.  When working outside flox, export it manually:

    export GH_TOKEN=ghp_yourTokenWithReadPackagesScope
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <pluginGroups>
    <pluginGroup>org.apache.maven.plugins</pluginGroup>
    <pluginGroup>org.codehaus.mojo</pluginGroup>
    <pluginGroup>org.eclipse.jetty</pluginGroup>
    <pluginGroup>org.openrewrite.maven</pluginGroup>
  </pluginGroups>
  <servers>
    <server>
      <id>github</id>
      <username>nxmatic</username>
      <password>${env.GH_TOKEN}</password>
    </server>
    <server>
      <id>github-seedmatic-rke2lab</id>
      <username>nxmatic</username>
      <password>${env.GH_TOKEN}</password>
    </server>
    <server>
      <id>github-seedmatic-java-systemd</id>
      <username>nxmatic</username>
      <password>${env.GH_TOKEN}</password>
    </server>
  </servers>

</settings>