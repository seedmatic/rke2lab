-include: ../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.seed.broker.codec
Export-Package: \
    io.seedmatic.rke2lab.seed.broker.codec
# Our OWN dual-realm library — the payload codec (SeedCodec) and its profiles, which carry jackson.
# type=dual-realm is staged as a bundle (installed in-framework, importing the OSGi copy of jackson and
# the seed-broker seam) AND kept flat in the host uber-jar (binding the host copy) — jackson's own
# treatment, for our code. Its exported package legitimately lives in two realms: it is NOT a seam
# surface (no codec type crosses the String-only seed-broker seam; each realm holds its own copy
# bound to its own jackson), so DUPLICATE_REALM_CLASS exempts it like jackson. The .internal jackson
# glue (WireEnumModule) is NOT exported — only SeedCodec and its three profiles are the API.
Provide-Capability: io.seedmatic.rke2lab.embed; type=dual-realm
