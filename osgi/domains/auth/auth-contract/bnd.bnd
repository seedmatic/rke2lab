-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.auth.contract
Export-Package: io.seedmatic.rke2lab.auth.contract
# type=contract — the auth domain's consumer-side vocabulary (the GithubWriterTokenMint and
# GithubReaderTokenMint verbs). Installed bundle-side and wired bundle-to-bundle, NOT a seam: the
# host no longer reads a resolved token back TYPED — it speaks only to the broker. The auth-edge
# satisfies the verbs through the ghapp minter. It carries no @Component, so it does NOT Require the
# SCR extender. The contract-purity guard fails the build if this bundle exports a
# concrete class. Supersedes the dissolved auth-port seam.
Provide-Capability: io.seedmatic.rke2lab.embed; type=contract
