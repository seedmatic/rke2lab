<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>manifests-contract</artifactId>
  <name>osgi/domains/manifests/manifests-contract</name>
  <description>The manifests contract — the domain vocabulary the OSGi manifests-core bundle
    implements and its consumers depend on. Pure POJO model in three packages: the
    synthesis/explode/update SPIs + their gateway contract + shared value/constant types (domain
    policy + catalog, annotations) in contract; NodeEnvContext/NodeEnvContributor in contract.node;
    the profiles value contract in contract.profiles. Zero impl, zero pulumi, zero osgi runtime.
    type=contract: installed bundle-side and wired bundle-to-bundle, not system-exported — the host
    speaks only to the broker. Versioned independently of the reactor GAV via per-package @Version
    (starts 1.0.0).</description>

  <dependencies>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
    </dependency>
    <!-- The dual-realm host face: ManifestSynthesisRequest embeds ComponentVersions (the version
         pins). It lives in the ingress leaf, not here, because the host bumper reads it FLAT — a
         type=contract package is bundle-wired only, never host-typed. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-ingress-contract</artifactId>
    </dependency>
    <!-- The seed-broker seam: the runbook-input wire-record carries @SeedContract("runbook") so the
         shape reflector can project its schema. Like doctor-contract's Consultation. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- checker-qual: @MonotonicNonNull for the set-once builder field. Analysis-only. -->
    <dependency>
      <groupId>org.checkerframework</groupId>
      <artifactId>checker-qual</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
