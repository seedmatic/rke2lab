<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Standalone third-party version catalog. The BOM has its own lifecycle and
    version, independent of the project: it pins the EXTERNAL dependency versions
    the modules build against. The rke2lab inter-module versions are NOT here —
    they share the project's lifecycle and are managed by the parent at
    ${project.version}. Having no <parent> is deliberate: it breaks the cycle that
    would otherwise arise from the parent importing this BOM.
  -->
  <groupId>io.seedmatic.rke2lab</groupId>
  <artifactId>bom</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>bom</name>
  <description>Standalone third-party version catalogue: pins the external dependency versions the
    modules build against. Own lifecycle, no parent (breaks the parent-imports-BOM cycle).</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <dbus.java.version>5.2.0</dbus.java.version>
    <java-systemd.version>3.0.0-rc.2</java-systemd.version>
    <grpc.version>1.83.1</grpc.version>
    <pulumi.version>1.35.0</pulumi.version>
    <pulumi.command.version>1.2.1</pulumi.command.version>
    <spring.boot.version>4.1.0</spring.boot.version>
    <jsr305.version>3.0.2</jsr305.version>
    <!-- Build-platform API the staging-extension core extension compiles against (provided; supplied
         by the running Maven). Third-party, so its version lives here like every other external dep.
         javax.inject only ever shipped version 1 — the @Inject annotations the Maven component uses. -->
    <maven.core.version>3.9.6</maven.core.version>
    <javax.inject.version>1</javax.inject.version>
    <jspecify.version>1.0.1</jspecify.version>
    <checker-qual.version>4.2.2</checker-qual.version>
    <!-- jetbrains annotations: the compile-only @Nullable/@NotNull set jsii + constructs reference in
         their bytecode. manifests-cdk8s embeds it (bnd -includeresource: annotations-*.jar;lib:=true)
         to give the nested cdk8s closure a real classloader. Once a transitive of software.constructs;
         constructs 10.8.0 dropped it, so it is declared EXPLICITLY (constructs is no longer a source
         for it) and pinned here. -->
    <jetbrains.annotations.version>19.0.0</jetbrains.annotations.version>
    <gson.version>2.14.0</gson.version>
    <!-- guava-bom version — see the dependencyManagement import below for the transitive-conflict
         rationale (pulumi 32.1.2 vs jGiven 33.4.8). -->
    <guava.version>33.6.0-jre</guava.version>
    <jackson.version>2.22.1</jackson.version>
    <asm.version>9.10.1</asm.version>
    <!-- networknt is the schema-conformance half of the broker contract (victools generates the
         schema, networknt validates payloads against it — SeedCodec.validate, still inert until the
         capstone). Held on the 2.x line: it is the last major on jackson 2 (com.fasterxml); 3.x moved
         to jackson 3 (tools.jackson) and needs a whole-project jackson-3 migration first. This is the
         sole source — the staging-extension consumes it version-less through build-parent's BOM
         import (its SCHEMA_CONCORD gate is the only user). -->
    <networknt.json-schema.version>2.0.4</networknt.json-schema.version>
    <!-- BouncyCastle: the pure-Java CA-hierarchy generator for the deterministic cluster PKI
         (cluster-pki-core). bc-jdk18on-bom keeps bcprov/bcpkix/bcutil in step (prov has a .2 patch
         pkix/util do not — the BOM resolves each to its right version). 1.78.1+ ships proper OSGi
         metadata, so the jars stage as native bundles. -->
    <bouncycastle.version>1.85.2</bouncycastle.version>
    <!-- fabric8 Kubernetes client: the cluster edge (cluster-edge) reads a published kubeconfig and
         probes kube-apiserver readiness / controller rollout through a typed client instead of
         shelling kubectl. kubernetes-client-bom manages the client + its model + the JDK HttpClient
         backend as one consistent set; the jars ship Bundle-SymbolicName + OSGi headers, so they
         stage as native bundles (the BouncyCastle path), not lib:=true embeds. -->
    <fabric8.version>7.8.0</fabric8.version>
    <!-- snakeyaml-engine (YAML 1.2): the kubeconfig parser fabric8-wrap imports. Distinct from the
         org.yaml:snakeyaml the rest of the project uses — fabric8's kubernetes-client-api binds
         org.snakeyaml:snakeyaml-engine, a first-class OSGi bundle (BSN org.snakeyaml.engine). It is
         the only NOT-yet-staged transitive the fabric8 wrap needs (jackson + BouncyCastle are
         already staged); declared here so the wrap can pin it and seed-master stage it. -->
    <snakeyaml-engine.version>3.1.1</snakeyaml-engine.version>
    <!-- victools 5.x migrated to jackson 3 (tools.jackson.* package); the project is on jackson 2
         (${jackson.version}), so the 4.x line is the ceiling — 5.0.0 makes generateSchema return a
         tools.jackson ObjectNode that will not satisfy a com.fasterxml JsonNode. Bump only with a
         whole-project jackson-3 migration. -->
    <victools.version>4.38.0</victools.version>
    <jgit.version>7.7.1.202607240634-r</jgit.version>
    <software.constructs.version>10.8.1</software.constructs.version>
    <cdk8s.version>2.70.90</cdk8s.version>
    <cdk8s.plus33.version>2.5.47</cdk8s.plus33.version>
    <slf4j.version>2.0.18</slf4j.version>
    <!-- Aligned with the logback pax-logging-logback ${pax.logging.version} pulls (2.3.4 → 1.5.34):
         StaticLogbackContext shares ONE LoggerContext between the host and pax, so both must be the
         same logback. On a pax bump, re-check `mvn -pl :runtime dependency:tree -Dincludes=ch.qos.logback`. -->
    <logback.version>1.6.1</logback.version>
    <ipaddress.version>5.6.2</ipaddress.version>
    <commons.compress.version>1.28.0</commons.compress.version>
    <jgiven.version>2.0.3</jgiven.version>
    <jagged.version>1.0.0</jagged.version>
    <felix.resolver.version>2.0.4</felix.resolver.version>
    <osgi.core.version>8.0.0</osgi.core.version>
    <felix.framework.version>7.0.5</felix.framework.version>
    <felix.metatype.version>1.2.4</felix.metatype.version>
    <felix.log.version>1.3.2</felix.log.version>
    <felix.configadmin.version>1.9.26</felix.configadmin.version>
    <felix.scr.version>2.2.18</felix.scr.version>
    <!--
      Pax Logging: the OSGi logging backend the launched framework drains to. pax-logging-api
      replaces org.slf4j for bundles; pax-logging-logback registers the OSGi LogService and, with
      StaticLogbackContext=true, reuses the HOST's logback context so framework/SCR/bundle logs all
      land in the host logs. 2.3.x targets OSGi R8 (matches felix.framework 7.0.5) and pulls
      logback 1.5.x — keep logback.version aligned with what pax pulls (below).
    -->
    <pax.logging.version>2.3.4</pax.logging.version>
    <osgi.metatype.version>1.4.1</osgi.metatype.version>
    <!--
      OSGi CONSTRUCTION annotations (compile-only, scope provided): bnd reads
      them to GENERATE the manifest headers + Metatype XML — the Java is the
      source of truth. Pinned individually because org.osgi:osgi.cmpn:8.1.0
      (which would bundle all three) is absent from Maven Central.
    -->
    <osgi.ds.annotations.version>1.5.1</osgi.ds.annotations.version>
    <osgi.metatype.annotations.version>1.4.1</osgi.metatype.annotations.version>
    <osgi.bundle.annotations.version>2.0.0</osgi.bundle.annotations.version>
    <osgi.versioning.annotations.version>1.1.2</osgi.versioning.annotations.version>
    <!--
      DS runtime API packages (org.osgi.service.component[.runtime], util.promise/function):
      felix.scr imports them as MANDATORY but osgi.core's system bundle does not carry them, so a
      launched SCR must get them from somewhere. The bench exports them from the system bundle via
      system.packages.extra (the typed-access trick), so these jars sit on the test classpath.
    -->
    <osgi.component.version>1.5.1</osgi.component.version>
    <osgi.util.promise.version>1.3.0</osgi.util.promise.version>
    <osgi.util.function.version>1.2.0</osgi.util.function.version>
    <!--
      The org.osgi.service.log API (LogLevel + Logger). Felix's system bundle does NOT export it and
      osgi.core carries it only where osgi.core is on-classpath; the host exec (seed-master) is flat
      and keeps osgi.core test-scoped (it would duplicate org.osgi.framework.* on the runtime JCL and
      break framework.init()). So the host names LogLevel through this SLIM spec artifact — the log
      packages ALONE, no framework classes — as the currency of the framework log-level knob.
    -->
    <osgi.service.log.version>1.5.0</osgi.service.log.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- BouncyCastle: the CA-hierarchy generator (cluster-pki-core) + the OpenSSH/PEM root-key
           reader. The jdk18on BOM manages bcprov/bcpkix/bcutil together; consumers declare the
           artifacts version-less. -->
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bc-jdk18on-bom</artifactId>
        <version>${bouncycastle.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- fabric8 Kubernetes client BOM: manages kubernetes-client + kubernetes-client-api + the
           kubernetes-model-* set + the httpclient backends in step; consumers declare the artifacts
           version-less. cluster-edge compiles against it (provided), seed-master stages the closure
           (runtime) — the BouncyCastle staging pattern, for a first-class OSGi bundle graph. -->
      <dependency>
        <groupId>io.fabric8</groupId>
        <artifactId>kubernetes-client-bom</artifactId>
        <version>${fabric8.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- The kubeconfig YAML parser fabric8 binds (not managed by the fabric8 BOM). The wrap
           declares it compile so seed-master stages it as its own bundle. -->
      <dependency>
        <groupId>org.snakeyaml</groupId>
        <artifactId>snakeyaml-engine</artifactId>
        <version>${snakeyaml-engine.version}</version>
      </dependency>
      <!-- ASM: one version for asm / asm-tree / asm-analysis via the BOM — the staging-extension's
           gates read bytecode (RecordPurity, RealmBoundary) and the PIPELINE_PATTERN read-face check
           runs a SourceInterpreter (asm-tree + asm-analysis); the BOM keeps the three in step. -->
      <dependency>
        <groupId>org.ow2.asm</groupId>
        <artifactId>asm-bom</artifactId>
        <version>${asm.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${networknt.json-schema.version}</version>
      </dependency>
      <!-- jagged: pure-Java age encryption (JCA X25519 + ChaCha20-Poly1305, no external provider on
           JDK 21+). jagged-wrap embeds these as one first-class OSGi bundle exporting
           com.exceptionfactory.jagged.* (jagged ships plain jars, no Bundle-SymbolicName). It backs
           the age CellarCipher — the multi-recipient seal of the seed-broker cellar. Pinned as the
           four artifacts DIRECTLY, NOT via jagged-bom: importing jagged-bom would inline its parent
           aggregator's dependencyManagement — which pins junit-bom 5.11.2 — and DOWNGRADE our JUnit
           Platform below 1.13, erasing org.junit.platform.engine.support.store.Namespace (used by
           junit-launcher). Direct version-pins bring the jagged modules without that transitive leak;
           only the x25519 recipient type + its framework/api/bech32 closure are carried. -->
      <dependency>
        <groupId>com.exceptionfactory.jagged</groupId>
        <artifactId>jagged-x25519</artifactId>
        <version>${jagged.version}</version>
      </dependency>
      <!-- jagged-ssh: the age SSH-recipient support (ssh-ed25519 / ssh-rsa stanzas). It converts an
           OpenSSH key internally (StandardEd25519KeyConverter, ed25519→X25519), so the cellar seals
           to / reveals with the rke2-cluster SSH key DIRECTLY — no ssh-to-age tool, no separate age
           key. Pulls jagged-x25519 (the internal X25519 agreement). -->
      <dependency>
        <groupId>com.exceptionfactory.jagged</groupId>
        <artifactId>jagged-ssh</artifactId>
        <version>${jagged.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exceptionfactory.jagged</groupId>
        <artifactId>jagged-framework</artifactId>
        <version>${jagged.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exceptionfactory.jagged</groupId>
        <artifactId>jagged-api</artifactId>
        <version>${jagged.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exceptionfactory.jagged</groupId>
        <artifactId>jagged-bech32</artifactId>
        <version>${jagged.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-bom</artifactId>
        <version>${slf4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        spring-boot-dependencies manages JUnit, Mockito and byte-buddy in a
        mutually consistent set (mockito 5.11.0 / byte-buddy 1.14.19 — the same
        byte-buddy JGiven uses), so the test toolchain needs no explicit versions.
      -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.github.hypfvieh</groupId>
        <artifactId>dbus-java-bom</artifactId>
        <version>${dbus.java.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- third-party dependencies -->
      <dependency>
        <groupId>com.github.thjomnx</groupId>
        <artifactId>java-systemd</artifactId>
        <version>${java-systemd.version}</version>
      </dependency>
      <dependency>
        <groupId>com.pulumi</groupId>
        <artifactId>pulumi</artifactId>
        <version>${pulumi.version}</version>
      </dependency>
      <dependency>
        <groupId>com.pulumi</groupId>
        <artifactId>command</artifactId>
        <version>${pulumi.command.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.code.findbugs</groupId>
        <artifactId>jsr305</artifactId>
        <version>${jsr305.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${jspecify.version}</version>
      </dependency>
      <dependency>
        <groupId>org.checkerframework</groupId>
        <artifactId>checker-qual</artifactId>
        <version>${checker-qual.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jetbrains</groupId>
        <artifactId>annotations</artifactId>
        <version>${jetbrains.annotations.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.maven</groupId>
        <artifactId>maven-core</artifactId>
        <version>${maven.core.version}</version>
      </dependency>
      <dependency>
        <groupId>javax.inject</groupId>
        <artifactId>javax.inject</artifactId>
        <version>${javax.inject.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>${gson.version}</version>
      </dependency>
      <!-- guava via its BOM — one version for guava / failureaccess / listenablefuture at once (the
           jackson-bom pattern). Resolves the transitive-conflict: com.pulumi 1.30 pulls 32.1.2-jre
           (nearest the root), jGiven 2.0.3 pulls 33.4.8-jre; jgiven-wrap is COMPILED against 33.4.8
           so its bundle imports com.google.common.*;version="[33.4,34)", unsatisfiable by a staged
           32.1.2. guava is strongly backward-compatible (33.x ⊃ 32.x), so pinning the latest -jre
           satisfies both realms — pulumi flat and the jgiven-wrap bundle. -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava-bom</artifactId>
        <version>${guava.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jgit</groupId>
        <artifactId>org.eclipse.jgit</artifactId>
        <version>${jgit.version}</version>
      </dependency>
      <!-- jgit's smart-HTTP test server (AppServer + GitServlet, pulls http.server + Jetty): the
           only transport jgit push does not deadlock (file:// and git:// are duplex and hang). -->
      <dependency>
        <groupId>org.eclipse.jgit</groupId>
        <artifactId>org.eclipse.jgit.junit.http</artifactId>
        <version>${jgit.version}</version>
      </dependency>
      <!-- JUnit 4: jgit's AppServer/HttpTestCase compile against org.junit.Assert and declare junit
           as `provided` (non-transitive), so a consumer running the http test server supplies it. -->
      <dependency>
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>4.13.2</version>
      </dependency>
      <dependency>
        <groupId>software.constructs</groupId>
        <artifactId>constructs</artifactId>
        <version>${software.constructs.version}</version>
      </dependency>
      <dependency>
        <groupId>org.cdk8s</groupId>
        <artifactId>cdk8s</artifactId>
        <version>${cdk8s.version}</version>
      </dependency>
      <dependency>
        <groupId>org.cdk8s</groupId>
        <artifactId>cdk8s-plus-33</artifactId>
        <version>${cdk8s.plus33.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>${commons.compress.version}</version>
      </dependency>
      <!-- logback-classic + logback-core are versioned in lock-step (classic binds core's internal
           API at its own version); pin BOTH here or spring-boot-dependencies wins for core and
           splits the pair (classic ${logback.version} over a stale core → LinkageError in the shared
           StaticLogbackContext). -->
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-core</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.jgiven</groupId>
        <artifactId>jgiven-core</artifactId>
        <version>${jgiven.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.jgiven</groupId>
        <artifactId>jgiven-junit5</artifactId>
        <version>${jgiven.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.seancfoley</groupId>
        <artifactId>ipaddress</artifactId>
        <version>${ipaddress.version}</version>
      </dependency>
      <!-- victools JSON-Schema generator (Draft 2020-12): the RecordSchemaProjector's engine — the
           amont projection of a wire-record's shape. The generator core + its jackson module (nested
           records, enum-slug, Optional → non-required); wrapped as an OSGi bundle in victools-wrap
           (both jars ship without a Bundle-SymbolicName). Via its BOM — one version for the generator
           + every module (the jackson-bom pattern). -->
      <dependency>
        <groupId>com.github.victools</groupId>
        <artifactId>jsonschema-generator-bom</artifactId>
        <version>${victools.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.felix</groupId>
        <artifactId>org.apache.felix.resolver</artifactId>
        <version>${felix.resolver.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>osgi.core</artifactId>
        <version>${osgi.core.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.felix</groupId>
        <artifactId>org.apache.felix.framework</artifactId>
        <version>${felix.framework.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.felix</groupId>
        <artifactId>org.apache.felix.metatype</artifactId>
        <version>${felix.metatype.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.felix</groupId>
        <artifactId>org.apache.felix.log</artifactId>
        <version>${felix.log.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.felix</groupId>
        <artifactId>org.apache.felix.configadmin</artifactId>
        <version>${felix.configadmin.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.felix</groupId>
        <artifactId>org.apache.felix.scr</artifactId>
        <version>${felix.scr.version}</version>
      </dependency>
      <!-- Pax Logging: api (replaces org.slf4j for bundles) + logback backend (LogService impl,
           reuses the host logback context via StaticLogbackContext) -->
      <!--
        Both pax-logging jars drag osgi.cmpn (the OSGi compendium aggregate: a real bundle exporting
        137 packages, incl. org.osgi.service.component / util.promise / util.function). Nothing here
        compiles against the compendium, and those DS-API packages are owned by their dedicated spec
        jars (staged as bundles). Left in, osgi.cmpn flattens into the exec uber-jar and the system
        bundle re-exports its 137 packages, splitting the staged trio's packages. Excluded HERE in the
        BOM so the cut applies on every transitive path, once — the enforcer bans it globally too.
      -->
      <dependency>
        <groupId>org.ops4j.pax.logging</groupId>
        <artifactId>pax-logging-api</artifactId>
        <version>${pax.logging.version}</version>
        <exclusions>
          <exclusion>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.cmpn</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>org.ops4j.pax.logging</groupId>
        <artifactId>pax-logging-logback</artifactId>
        <version>${pax.logging.version}</version>
        <exclusions>
          <exclusion>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.cmpn</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.service.metatype</artifactId>
        <version>${osgi.metatype.version}</version>
      </dependency>
      <!-- OSGi construction annotations — bnd-consumed, scope provided at use site -->
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.service.component.annotations</artifactId>
        <version>${osgi.ds.annotations.version}</version>
      </dependency>
      <!-- DS runtime API (service.component + .runtime + .runtime.dto) felix.scr requires at run -->
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.service.component</artifactId>
        <version>${osgi.component.version}</version>
      </dependency>
      <!-- The org.osgi.service.log API (LogLevel currency of the framework log-level knob) — the
           slim spec artifact, host-side only (see the version property note). -->
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.service.log</artifactId>
        <version>${osgi.service.log.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.util.promise</artifactId>
        <version>${osgi.util.promise.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.util.function</artifactId>
        <version>${osgi.util.function.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.service.metatype.annotations</artifactId>
        <version>${osgi.metatype.annotations.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.annotation.bundle</artifactId>
        <version>${osgi.bundle.annotations.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.annotation.versioning</artifactId>
        <version>${osgi.versioning.annotations.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
