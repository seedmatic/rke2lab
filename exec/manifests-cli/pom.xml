<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>build-parent</artifactId>
    <version>0.0.0</version>
    <relativePath>../../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>manifests-cli</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <name>exec/manifests-cli</name>
  <description>Manifests CLI: the executable north-adapter that drives the manifests core
    (osgi/manifests/manifests-core) for ad-hoc synthesis (`java -jar … synthesize`). Boots an
    embedded Felix from the bundles staged in its -exec jar (the same boot seam as seed-outcluster) and
    reads ManifestSynthesisService from the registry — no flat ServiceLoader.</description>

  <dependencies>
    <!-- The host-world boot infrastructure: OsgiRuntime + (transitively) the whole boot stack
         (felix.framework + osgi.core compile, felix.scr + felix.resolver + pax-logging + the
         DS-runtime API runtime). The CLI compiles against OsgiRuntime; the felix/pax jars it only
         stages + installs, never compiles against. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>framework-launcher</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.framework</artifactId>
    </dependency>
    <!-- The seam contract the CLI consumes, kept flat on the host classpath as the SINGLE exporter
         (manifests-core imports but does not export it); OsgiRuntime mirrors it onto the system
         bundle so the embedded manifests-core resolves against this one copy — typed access. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-contract</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The dual-realm host face — COMPILE scope: the `versions` verb builds the bump facet TYPED
         (Component / BumpLevel are WireEnums here), so the host names these ingress types directly.
         A flat consumer references it again, so the demand-fold keeps it flat in this assembly AND
         stages it as a bundle (type=dual-realm), the in-container scion resolving the SAME copy. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-ingress-contract</artifactId>
    </dependency>
    <!-- The model bundle: embedded INTACT under META-INF/bundles (stage-embedded-bundles below) and
         installed by OsgiRuntime, NOT flattened into the uber-jar (excluded from the shade). runtime
         scope MACHINE-ENFORCES path 2: the CLI compiles only against -port + OsgiRuntime, never
         against a manifests-core impl type — the compiler now forbids the host→impl leak. The stage
         execution still resolves the reactor artifact at runtime scope. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-core</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-cdk8s</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- The ssh-to-age edge: embedded INTACT under META-INF/bundles (staged below) + installed by
         OsgiRuntime, NOT flattened (excluded from the shade). runtime scope — the CLI never compiles
         against the edge impl; manifests-core's @Reference SshToAgeConverter binds it from the
         registry. Mandatory reference, so the edge MUST be embedded or the service never publishes. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ssh-to-age-edge</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- BDD-as-engine: the CLI drives ManifestsCliScenario on the embedded JUnit launcher (the same
         machinery seed-outcluster uses), sowing the `manifests` coordinate through the broker instead of
         resolving a typed domain service host-side. -->
    <!-- The launcher engine + OSGi connection contract (JUnitLauncherCore transits via this): the
         host scenario reaches OsgiConnection/SeedRuntime/ScenarioCellar/RunRole/TxIdSeed here. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
    </dependency>
    <!-- The neutral launcher core (JUnitLauncherCore) the CLI hands the engine to; a DIRECT import
         (Main names it), never leaned on transitively through scenario-engine. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>junit-launcher</artifactId>
    </dependency>
    <!-- The common gardening spine consumed FLAT (SeedReceiver, SessionSeed, Gardening.sow). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-bdd</artifactId>
    </dependency>
    <!-- The broker seam the host speaks (Amendment roles + Cellar); the ONE host<->OSGi membrane. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- The broker mechanism (embed type=runtime): DefaultSeedBroker + DefaultAmendmentAssembler,
         staged under META-INF/bundles and published by SCR so the sow resolves the manifests door.
         Without it the registry holds only the broker CONTRACT and Gardening.open() finds no
         gardener. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-runtime</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The pax-logging-logback fragment (embed type=model) carrying the logback policy in Java. On
         the graph so the staging closure stages it under META-INF/bundles; at boot it attaches to
         pax-logging-logback and the launcher invokes its PaxLogbackConfigurer reflectively. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>pax-logback-config</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The manifests SCION bundle (embed type=model): ManifestsRunbookHandler serves the `manifests`
         coordinate and grows ManifestSynthesisScenario in-container. Staged INTACT like the edges. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-bdd</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The version-bump scion's service impls (embed type=model/edge), staged INTACT like the other
         bundles so VersionBumpScenario's @OsgiService injections resolve bundle-side: worktree-core
         (JgitWorktree — jgit stage/commit), auth-edge (GithubWriterTokenMintEdge — mints a fresh
         WRITER token for the release query, @References ghapp's GithubAppMinter below), ndh-core
         (DefaultNdhKeystoreReader — the tailnet authorityDomain). runtime scope: the host never
         compiles against an impl, only stages it; the contracts arrive transitively. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>worktree-core</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>auth-edge</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ndh-core</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The publish verb's auth sub-graph (embed type=model/edge), staged INTACT so the `publish`
         flow's in-container scions resolve bundle-side: ghapp-bdd (the `ghapp` scion — rehydrates the
         one org App's credentials from .secrets through the SecretsGateway seam) + ghapp-edge (the
         GithubAppMinter @Component). The push token is NOT sealed: the manifests delivery reveals the
         App credentials and mints a fresh WRITER token AT THE POINT OF USE via the auth-edge
         GithubWriterTokenMintEdge (embedded above) — no durable, staleable seal. synthesize needs
         none of these; publish grows the ghapp coordinate then mints on demand. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ghapp-bdd</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ghapp-edge</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- bouncycastle on the FLAT host classpath so BootPlanner can system-export the packages
         ghapp-edge's GithubAppMinter imports (JWT signing from the App's RSA private-key PEM):
         org.bouncycastle.{asn1.pkcs, jce.provider, openssl, openssl.jcajce}. Without them the boot
         fails deriving system.packages.extra (ghapp-edge unresolved) — the same reason seed-outcluster
         carries them for cluster-pki-core. runtime scope: the host never compiles against bc. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcutil-jdk18on</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- host-runtime (COMPILE): the publish scenario registers the SecretsGateway the ghapp scion
         reads, resolved container-blind through new ExecutionEnvironment(System.getenv()) — OPERATOR
         here (the operator's .secrets + ndh OAuth client). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>host-runtime</artifactId>
    </dependency>
    <!-- jGiven-in-OSGi wrap, dual-realm (staged as a bundle AND kept host-flat): the host root
         scenario is a jGiven ScenarioTest, so jgiven runs FLAT for it and as a BUNDLE for the
         in-container scion. Directly declared = the realm-library signal (StagingClosure). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>jgiven-wrap</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- jGiven the host scenario compiles against (ScenarioTestBase, Stage, annotations) + its
         JUnit5 extension (@SeedScenario wears JGivenExtension) — runtime code here, not test-only. -->
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
    </dependency>
    <!-- The Jupiter API + engine are runtime code here: the CLI hands JupiterTestEngine.class to
         JUnitLauncherCore to play the scenario, and the scenario declares @Test/@RegisterExtension. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
    </dependency>
    <!-- JUnit Platform artifacts the CLI imports DIRECTLY (never via junit-launcher's transitive
         graph): DiscoverySelectors (platform-engine) to select the scenario, and
         SummaryGeneratingListener (platform-launcher) to read the run verdict. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
    </dependency>
    <!-- junit-jupiter-params staged as a bundle (runtime): jgiven-junit5 imports the params packages
         MANDATORY in its bytecode, so the wire must resolve in-framework though we run no
         @ParameterizedTest. Same treatment as seed-outcluster. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The scenario builds the SOIL amendment as a JsonNode; jackson-databind is a compile dep. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- The org.osgi.service.log API (LogLevel): scenario-engine's OsgiConnection exposes it as the
         framework log-level knob's currency, so the host flat classpath must carry it or the boot
         hits NoClassDefFoundError. The SLIM spec artifact (log packages ALONE — no
         org.osgi.framework.*), so it cannot shadow the framework classes felix.framework provides.
         Same declaration seed-outcluster carries. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.log</artifactId>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- Host slf4j binds to java.util.logging (slf4j-jdk14): host logs ride the JDK JUL bus, drained
         by pax-logging-api's JdkHandler into pax-logging-logback. No host logback backend. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
    </dependency>
    <!-- The embedded-Felix CLI-scope test boots the same topology as the deployed jar. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>junit-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
        <excludes>
          <exclude>logback.xml</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.build.directory}/generated-resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>logback.xml</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.seedmatic.rke2lab.manifests.cli.Main</mainClass>
        </configuration>
      </plugin>
      <!-- Flags + artifact filter inherited from build-parent's managed shade
           execution; only the per-module transformers + the embed-exclusions are declared here. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <!-- Shade excludes DERIVED + injected by the osgi-staging-extension from what the
                   bundles declare — no hand-list. The empty artifactSet is the seam it fills. -->
              <artifactSet>
                <excludes/>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.seedmatic.rke2lab.manifests.cli.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <!-- Stage the designed-for-OSGi jars INTACT under META-INF/bundles (a <resource> root, so
               they land in the uber-jar AND on the test classpath). OsgiRuntime.embedded* streams
               each into Felix at boot. The artifactItems are DERIVED + injected by the
               osgi-staging-extension (same closure as the shade excludes), single-sourced. -->
          <execution>
            <id>stage-embedded-bundles</id>
            <goals>
              <goal>copy</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <skip>${rke2lab.staging.skip}</skip>
              <outputDirectory>${project.build.directory}/generated-resources/META-INF/bundles</outputDirectory>
              <overWriteReleases>true</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
              <artifactItems/>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>m2e</id>
      <activation>
        <property>
          <name>m2e.version</name>
        </property>
      </activation>
      <properties>
        <rke2lab.staging.skip>true</rke2lab.staging.skip>
      </properties>
    </profile>
  </profiles>
</project>
