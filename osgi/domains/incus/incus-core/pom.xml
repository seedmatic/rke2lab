<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>incus-core</artifactId>
  <name>osgi/domains/incus/incus-core</name>
  <description>The incus domain's in-container logic: the grow-view projectors (GrowNetworkResolver /
    GrowIdentityResolver / GrowPlanAssembler the provision scion assembles the InstanceGrowPlan from)
    and the launch-secrets writer — pure Java driven by the incus scenarios. type=model — installed
    as a bundle, wired bundle-to-bundle to the scion. The wire-records live in incus-contract; this
    module holds only the logic. The former host-tree slot-rotation / staging→live promotion moved to
    git (the rendered-branch model) and was removed.</description>

  <dependencies>
    <!-- The host-tree wire-records the fold decodes + the entries the CRUD writes. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>incus-contract</artifactId>
    </dependency>
    <!-- The flat grow views the scion projects (GrowNetworkView): GrowNetworkResolver assembles it. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>incus-ingress-contract</artifactId>
    </dependency>
    <!-- The netplan blueprint + synthesis service GrowNetworkResolver reads to project the NIC hwaddrs
         and the dnsmasq config the per-cluster bridge carries. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>netplan-contract</artifactId>
    </dependency>
    <!-- The codec the fold uses to decode the cellar-timeline envelopes. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>
    <!-- SeedEnvelope is imported directly (not only via seed-broker-codec) — declare the port. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
