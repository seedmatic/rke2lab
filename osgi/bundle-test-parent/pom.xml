<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>bundle-test-parent</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>osgi/bundle-test-parent</name>
  <description>Parent of the OSGi -test FRAGMENTS (doctor-core-test, doctor-contract-test,
    scenario-probe-test, …). A fragment carries its tests in src/main so they land in the fragment
    and run white-box through the host classloader; that bytecode therefore needs the JUnit + jGiven
    recipe at PROVIDED scope (build-parent gives it only at test scope, which a fragment's src/main
    cannot see). Declared once here so every fragment is uniform and BDD-capable by default — the
    in-container InContainerJUnitRunner + jGiven are reachable whether or not a given fragment uses
    them yet. The out-of-container harness (src/test) gets junit-platform-launcher too; it pulls
    platform-engine/commons + opentest4j/apiguardian transitively.</description>

  <properties>
    <!-- scenario-testkit's jgiven-fragment.bnd is -included by the fragments that run jGiven, yet
         lives in another module, where their build cache never looks: an edit there served each of
         them its cached manifest. Keyed here for every fragment, the BDD-capable default above —
         the few that include no jGiven yet rebuild with the others, which is never stale. -->
    <maven.build.cache.input.2>${maven.multiModuleProjectDirectory}/osgi/runtime/scenario-testkit/src/main/resources/jgiven-fragment.bnd</maven.build.cache.input.2>
  </properties>

  <dependencies>
    <!-- The runtime-playable machinery, now in the engine module (JUnit/jGiven are runtime-scope):
         OutOfContainerFrameworkExtension (src/test harness), InContainerJUnitRunner (src/main, runs
         the @Tests in-framework), ScrDiagnostics (src/main). provided keeps the in-container half out
         of the fragment jar — it resolves as its own bundle at runtime. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The JUnit-in-OSGi testkit: now only the test-only tags (@Osgi/@Pipeline) a fragment wears. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>junit-testkit</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The fragment's src/main @Test classes compile against Jupiter; provided keeps them out of
         the fragment jar — they resolve as their own OSGi bundle at runtime. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The in-container runner names JupiterTestEngine.class (so bnd imports the engine package). -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- BDD by default: jGiven scenarios compile in any fragment's src/main without redeclaration. -->
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The src/test harness boots Felix and drives a JUnit Platform Launcher; on the test classpath. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Declarative Services on the test classpath: felix.scr + the DS-runtime API trio it wires to.
         A -test harness that boots SCR (OutOfContainerFrameworkExtension.withScr()) installs these
         bundle-to-bundle so a fragment-contributed @Component activates. The domains are becoming
         @Components, so booting SCR is the norm for in-container tests — declared once here, every
         fragment inherits it (a non-SCR test only carries a slightly wider TEST classpath, never an
         embedded jar). org.osgi.service.component also carries the runtime DTOs ScrDiagnostics reads. -->
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.scr</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- felix.resolver on the test classpath: the org.osgi.service.resolver.Resolver SERVICE
         provider (its Bundle-Activator registers it), a mandatory @Reference of the manifests +
         unitrepo synthesis @Components. A -test harness that boots a scion driving REAL synthesis
         (OutOfContainerFrameworkExtension.withResolver(), on by default like withScr()) installs +
         starts it so those components activate. Declared once here — every fragment inherits it,
         exactly like felix.scr; a world that does not need it opts out with .withoutResolver().
         Same osgi.core:5.0.0 exclusion as manifests-core (it would shadow osgi.core 8.0.0). -->
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.resolver</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.osgi</groupId>
          <artifactId>org.osgi.core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.promise</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.function</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- The slf4j BACKEND for the out-of-container harness. junit-testkit carries slf4j-api ONLY (its
         diagnostic — OutOfContainerFrameworkExtension.resolve() logging a bundle's unsatisfied
         requirements — was muted by the NOP provider); the backend belongs to the consuming test
         module, declared here so every -test fragment surfaces that diagnostic uniformly. Host-side
         (JVM/JCL) only: logback exports ch.qos.logback.* (never org.slf4j), and the boot closure is
         selected by explicit BSN with org.slf4j served as a flat systemPackage — so logback can never
         be swept into the framework, the trap that a second org.slf4j provider (pax-logging-api) once
         was. Version BOM-managed; the shared logback-test.xml ships in the junit-testkit jar. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Pin logback as the slf4j provider so a future transitive provider cannot silently win
               over it (same guard as boot-logging). These are host-side -test runs; the framework's
               own LogService (pax-logging) lives in osgi/runtime and never reaches this classpath. -->
          <systemPropertyVariables>
            <slf4j.provider>ch.qos.logback.classic.spi.LogbackServiceProvider</slf4j.provider>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
