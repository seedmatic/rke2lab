{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Main",
            "request": "launch",
            "mainClass": "io.seedmatic.rke2lab.manifests.cli.Main",
            "projectName": "manifests-cli"
        },
        {
            "type": "java",
            "name": "Attach to Pulumi RKE2Lab",
            "request": "attach",
            "projectName": "seed-outcluster",
            "hostName": "localhost",
            "port": "8000"
        },
        {
            "type": "java",
            "name": "Attach to RKE2Lab Manifests CLI",
            "request": "attach",
            "projectName": "manifests-cli",
            "hostName": "localhost",
            "port": "8000"
        },
        {
            "type": "go",
            "name": "Attach to NRI Plugin (remote)",
            "request": "attach",
            "debugAdapter": "legacy",
            "mode": "remote",
            "host": "bioskop-master",
            "port": 2345,
            "cwd": "${workspaceFolder:rke2lab}/manifests/src/main/resources/runtime/flox-runtime/wrapper-go",
            "substitutePath": [
                {
                    "from": "${workspaceFolder:rke2lab}/manifests/src/main/resources/runtime/flox-runtime/wrapper-go",
                    "to": "github.com/nxmatic/rke2lab/containerd-shim-flox-wrapper"
                }
            ],
            "showLog": true,
            "trace": "verbose"
        },
        {
            "type": "java",
            "name": "Debug DbusTcpSpike",
            "request": "launch",
            "projectName": "rke2lab-seed-outcluster",
            "mainClass": "io.seedmatic.rke2lab.controlplane.DbusTcpSpike",
            "args": "${input:dbusTcpSpikeArgs}",
            "cwd": "${workspaceFolder:rke2lab}/exec/seed-outcluster",
            "console": "internalConsole",
            "stopOnEntry": false,
            "vmArgs": "-Dorg.slf4j.simpleLogger.defaultLogLevel=info -Dorg.slf4j.simpleLogger.log.org.freedesktop.dbus=trace -Dorg.slf4j.simpleLogger.showDateTime=true -Dorg.slf4j.simpleLogger.dateTimeFormat=HH:mm:ss.SSS"
        },
        {
            "type": "java",
            "name": "Launch DbusTcpSpike (JDWP suspend, attach later)",
            "request": "launch",
            "projectName": "rke2lab-seed-outcluster",
            "mainClass": "io.seedmatic.rke2lab.controlplane.DbusTcpSpike",
            "args": "${input:dbusTcpSpikeArgs}",
            "cwd": "${workspaceFolder:rke2lab}/exec/seed-outcluster",
            "console": "internalConsole",
            "vmArgs": "-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=*:5006 -Dorg.slf4j.simpleLogger.defaultLogLevel=info -Dorg.slf4j.simpleLogger.log.org.freedesktop.dbus=trace"
        },
        {
            "type": "java",
            "name": "Attach to DbusTcpSpike (JDWP :5006)",
            "request": "attach",
            "projectName": "rke2lab-seed-outcluster",
            "hostName": "localhost",
            "port": 5006
        },
        {
            "type": "java",
            "name": "Launch manifests Main",
            "request": "launch",
            "mainClass": "io.seedmatic.rke2lab.manifests.Main",
            "args": "${input:manifestsCommandArgs}",
            "cwd": "${workspaceFolder:rke2lab}/manifests",
            "console": "internalConsole",
            "vmArgs": "-Drke2lab.manifests.outdir=${workspaceFolder:rke2lab}/manifests/target -Drke2lab.manifests.file=${workspaceFolder:rke2lab}/manifests/target/manifests.yaml"
        }
    ],
    "inputs": [
        {
            "id": "manifestsCommandArgs",
            "type": "pickString",
            "description": "Select arguments for io.seedmatic.rke2lab.manifests.Main",
            "default": "shim-build",
            "options": [
                "synthesize",
                "shim-build",
                "shim-build guest",
                "shim-build host",
                "nix-flake-update",
                "nix-flake-update guest",
                "nix-flake-update host",
                "materialize-shim-assets",
                "materialize-shim-assets ."
            ]
        },
        {
            "id": "dbusTcpSpikeArgs",
            "type": "pickString",
            "description": "Arguments for DbusTcpSpike (host port target)",
            "default": "10.80.0.10 12434 default.target",
            "options": [
                "10.80.0.10 12434 default.target",
                "10.80.0.10 12434 multi-user.target",
                "10.80.0.10 12434 rke2lab.target"
            ]
        },
        {
            "id": "shimWrapperDlvHost",
            "type": "promptString",
            "description": "Host running Delve for the shim wrapper",
            "default": "127.0.0.1"
        }
    ]
}