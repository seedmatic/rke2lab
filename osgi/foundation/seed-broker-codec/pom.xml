<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>
  <artifactId>seed-broker-codec</artifactId>
  <name>osgi/foundation/seed-broker-codec</name>
  <description>The payload codec (SeedCodec) and the file / wire profiles, written once and loaded per realm — our own
    dual-realm library (embed; type=dual-realm, jackson's treatment for our code): staged as a bundle
    OSGi-side (importing the OSGi jackson + seed-broker seam, exporting seed.broker.codec) AND
    shaded flat host-side (binding the host jackson). No codec type crosses the String-only seam;
    each realm holds its own copy. See docs/architecture/osgi/seed-broker-spec.adoc.</description>
  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- The codec imports jackson-core (JsonParser, TypeReference) and jackson-annotation directly,
         not only through databind — declare them so the direct use is explicit. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <!-- jackson's own official datatype modules, registered EXPLICITLY by SeedCodec: jsr310's
         JavaTimeModule (Instant ↔ ISO-8601, replacing a hand-rolled module) and jdk8's Jdk8Module
         (Optional). Realm-isolated jackson artifacts imported bundle-to-bundle like jackson-databind
         (NOT nested — explicit registration means no ServiceLoader discovery drives them; the staging
         closure keeps each realm its own copy bound to that realm's databind). -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jdk8</artifactId>
    </dependency>
    <!-- The canonical / reading profiles write and read YAML as well as JSON; imported like
         jackson-databind (each realm binds its own copy). -->
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
    <!-- The wire-contract + WireEnum the codec (de)serializes. provided: the seed-broker seam is
         system-exported OSGi-side and flat host-side in BOTH realms, so the codec compiles against
         it and bnd emits an Import-Package for it, but it must NOT be embedded (that would duplicate
         the seam class → a realm collision). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
