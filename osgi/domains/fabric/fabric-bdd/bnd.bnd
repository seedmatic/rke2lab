-include: ../../../bundle-parent/annotations.bnd
Bundle-SymbolicName: io.seedmatic.rke2lab.fabric.bdd

# A type=model embeddable bundle (scanned + installed under META-INF/bundles by the
# io.seedmatic.rke2lab.embed capability, like dataplan-bdd). It is isDomain, so StagingClosure stages
# its import closure.
Provide-Capability: io.seedmatic.rke2lab.embed; type=model; model=fabric-bdd

# No Export-Package: the scenario class is not shared. The launcher plays it by class-selection; the
# host grafts its serialized ScenarioModel. The class never crosses a realm boundary.

# FabricRunbookHandler + FabricAmendReflector (@Component) publish the SeedHandlers serving the
# fabric runbook + amend coordinates: the broker's host→scion doors. SCR reads Service-Component off
# the manifest; the wildcard picks up the generated descriptors.
Service-Component: OSGI-INF/*.xml

# jGiven's runtime-woven packages, invisible to bnd's bytecode analysis, forced exactly as
# dataplan-bdd does (byte-buddy DEFINES stage-proxy classes into these at runtime). JSpecify +
# checker-qual are compile-only (stripped via ${annotation-noimports}).
Import-Package: \
    ${annotation-noimports}, \
    com.tngtech.jgiven.impl, \
    com.tngtech.jgiven.impl.intercept, \
    com.tngtech.jgiven.*, \
    *
