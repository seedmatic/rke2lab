<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>build-parent</artifactId>
    <version>0.0.0</version>
    <relativePath>../../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>plan-cli</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <name>exec/plan-cli</name>
  <description>Plan CLI: the executable north-adapter for the cross-repo plan exports, multiplexing
    two planes over one door — `plan network export` (the network blueprint, sowing the `netplan`
    coordinate) and `plan dataset export` (the ZFS dataset layout, sowing the `dataplan` coordinate).
    Each verb drives PlanCliScenario on the embedded JUnit launcher (the same BDD-as-engine machinery
    seed-outcluster + manifests-cli use), sowing the plane's coordinate through the broker; that grows
    the domain scion in-container (NetplanBlueprintScenario / DataplanScenario, where the
    type=contract records are reachable) which writes its export JSON into a SOIL temp dir. The CLI
    reads that host-neutral JSON back and renders it (YAML for network, JSON for dataset) — no
    contract type crosses to the flat host. The domains stay separate; only the ingress is unified.</description>

  <dependencies>
    <!-- The host-world boot infrastructure: OsgiRuntime + (transitively) the whole boot stack
         (felix.framework + osgi.core compile, felix.scr + felix.resolver + pax-logging + the
         DS-runtime API runtime). The CLI compiles against OsgiRuntime; the felix/pax jars it only
         stages + installs, never compiles against. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>framework-launcher</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.framework</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>

    <!-- BDD-as-engine: the CLI drives PlanCliScenario on the embedded JUnit launcher, sowing the
         plane's coordinate through the broker instead of referencing a type=contract bundle record
         flat host-side. Mirrors the manifests-cli dep set. -->
    <!-- The launcher engine + OSGi connection contract: the host scenario reaches
         OsgiConnection/SeedRuntime/ScenarioCellar/RunRole/TxIdSeed/LogFileSeed/ScenarioOutcomeSeed. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
    </dependency>
    <!-- The neutral launcher core (JUnitLauncherCore) PlanCli names directly. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>junit-launcher</artifactId>
    </dependency>
    <!-- The common gardening spine consumed FLAT (SeedReceiver, SessionSeed, Gardening.sow,
         EphemeralCellar). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-bdd</artifactId>
    </dependency>
    <!-- The broker seam the host speaks (Amendment roles + Cellar); the ONE host<->OSGi membrane. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- The broker mechanism (embed type=runtime): DefaultSeedBroker + DefaultAmendmentAssembler,
         staged under META-INF/bundles + published by SCR so the sow resolves the plane's door. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-runtime</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The pax-logging-logback fragment (embed type=model) carrying the logback policy in Java. On
         the graph so the staging closure stages it under META-INF/bundles; at boot it attaches to
         pax-logging-logback and the launcher invokes its PaxLogbackConfigurer reflectively. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>pax-logback-config</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The two harvests the export reads back, by their coordinates: compile scope, because the
         host NAMES them (that is what earns each a dual-realm ingress module — it is staged as a
         bundle for the scions AND kept flat for this host). Never a slug literal. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>netplan-ingress-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>dataplan-ingress-contract</artifactId>
    </dependency>
    <!-- The netplan SCION bundle (embed type=model): serves the `netplan` coordinates and grows
         NetplanBlueprintScenario in-container. Staged INTACT; it pulls netplan-contract into the
         staged world via its import closure (no flat host copy). The `network` plane's door. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>netplan-bdd</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The dataplan SCION bundle (embed type=model): serves the `dataplan` coordinates and grows
         DataplanScenario in-container (pulls dataplan-contract via its import closure). The `dataset`
         plane's door. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>dataplan-bdd</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The fabric DELIVERY scion (embed type=model): reads the netplan + dataplan harvests of the
         run and writes fabric/plan; the `publish` verb sows it. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>fabric-bdd</artifactId>
    </dependency>
    <!-- The publish verb's PUSH closure, the same set manifests-cli's publish stages and for the same
         reasons; it is the path by which auth-contract and ghapp-contract enter this assembly ON
         PURPOSE. ghapp-bdd (the `ghapp` scion — rehydrates the one org App's credentials from
         .secrets through the SecretsGateway seam) + ghapp-edge (the GithubAppMinter, the JWT signer);
         auth-edge (GithubWriterTokenMintEdge — the mint GithubAppTokens calls); ndh-core
         (DefaultNdhKeystoreReader — the authority domain and the signing key the delivery commit is
         signed with); worktree-core (JgitLinkedWorktrees — the fabric/plan linked worktree and its
         fast-forward push). runtime scope: the host compiles against none of them, it stages them. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ghapp-bdd</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ghapp-edge</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>auth-edge</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ndh-core</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>worktree-core</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- bouncycastle on the FLAT host classpath so BootPlanner can system-export the packages
         ghapp-edge's GithubAppMinter imports (JWT signing from the App's RSA private-key PEM).
         Without them the boot fails deriving system.packages.extra — manifests-cli's reason too. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcutil-jdk18on</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- host-runtime (COMPILE): the publish scenario registers the SecretsGateway the ghapp scion
         reads, resolved container-blind through new ExecutionEnvironment(System.getenv()). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>host-runtime</artifactId>
    </dependency>
    <!-- jGiven-in-OSGi wrap, dual-realm (staged as a bundle AND kept host-flat): the host root
         scenario is a jGiven ScenarioTest, so jgiven runs FLAT for it and as a BUNDLE for the scion. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>jgiven-wrap</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- jGiven the host scenario compiles against (ScenarioTestBase, Stage, annotations) + its
         JUnit5 extension + the ReportModel/ExecutionStatus PlanCli reads the run verdict from. -->
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
    </dependency>
    <!-- The Jupiter API + engine are runtime code here: the CLI hands JupiterTestEngine.class to
         JUnitLauncherCore to play the scenario, and the scenario declares @Test/@RegisterExtension. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
    </dependency>
    <!-- JUnit Platform artifacts the CLI imports DIRECTLY: DiscoverySelectors (platform-engine) to
         select the scenario, SummaryGeneratingListener (platform-launcher) to read the verdict. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
    </dependency>
    <!-- junit-jupiter-params staged as a bundle (runtime): jgiven-junit5 imports the params packages
         MANDATORY in its bytecode, so the wire must resolve in-framework. Same as seed-outcluster. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The scenario builds the SOIL amendment as a JsonNode, and PlanCli parses the export JSON
         then re-emits it (YAML/JSON) — jackson-databind + jackson-dataformat-yaml are compile deps. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <!-- The org.osgi.service.log API (LogLevel): scenario-engine's OsgiConnection exposes it as the
         framework log-level knob's currency, so the host flat classpath must carry it or the boot
         hits NoClassDefFoundError. The SLIM spec artifact. Same declaration seed-outcluster carries. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.log</artifactId>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- Host slf4j binds to java.util.logging (slf4j-jdk14): host logs ride the JDK JUL bus, drained
         by pax-logging-api's JdkHandler into pax-logging-logback. No host logback backend. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
    </dependency>
    <!-- The embedded-Felix CLI-scope test boots the same topology as the deployed jar. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>junit-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
        <excludes>
          <exclude>logback.xml</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.build.directory}/generated-resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>logback.xml</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.seedmatic.rke2lab.plan.cli.PlanCli</mainClass>
        </configuration>
      </plugin>
      <!-- Flags + artifact filter inherited from build-parent's managed shade
           execution; only the per-module transformers + the embed-exclusions are declared here. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <!-- Shade excludes DERIVED + injected by the osgi-staging-extension from what the
                   bundles declare — no hand-list. The empty artifactSet is the seam it fills. -->
              <artifactSet>
                <excludes/>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.seedmatic.rke2lab.plan.cli.PlanCli</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <!-- Stage the designed-for-OSGi jars INTACT under META-INF/bundles (a <resource> root, so
               they land in the uber-jar AND on the test classpath). OsgiRuntime.embedded* streams
               each into Felix at boot. The artifactItems are DERIVED + injected by the
               osgi-staging-extension (same closure as the shade excludes), single-sourced. -->
          <execution>
            <id>stage-embedded-bundles</id>
            <goals>
              <goal>copy</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <skip>${rke2lab.staging.skip}</skip>
              <outputDirectory>${project.build.directory}/generated-resources/META-INF/bundles</outputDirectory>
              <overWriteReleases>true</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
              <artifactItems/>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>m2e</id>
      <activation>
        <property>
          <name>m2e.version</name>
        </property>
      </activation>
      <properties>
        <rke2lab.staging.skip>true</rke2lab.staging.skip>
      </properties>
    </profile>
  </profiles>
</project>
