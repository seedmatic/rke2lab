<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-test-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-test-parent/pom.xml</relativePath>
  </parent>

  <artifactId>manifests-core-test</artifactId>
  <name>osgi/domains/manifests/manifests-core-test</name>
  <description>The -test fragment of manifests-core: a Fragment-Host attached to the manifests-core
    bundle, sharing its classloader so its actor tests run IN-CONTAINER and exercise manifests-core's
    DS @Components (YamlMapper, the ManifestExplodeService) through the registry — injected, not
    hand-wired with new Default…(). manifests-core was written before the OSGi move, so its tests were
    flat-classpath POJO; now that manifests uses DS correctly, the in-container model removes the
    hand-wired fixtures. It carries, in src/main so they land in the fragment, the actor @Test classes
    + the ManifestsCoreTests runner; the src/test probe boots Felix, resolves the whole manifests-core
    graph (the cdk8s carrier + its systemd fragment included — the live proof the cdk8s
    bundle-to-bundle wiring resolves in-container), and drives them through the host loader.</description>

  <dependencies>
    <!-- The JUnit-in-OSGi testkit, Jupiter, the engine, jGiven (jgiven-junit5), and the platform
         launcher all come from bundle-test-parent. Only module-specific deps are named below. -->

    <!-- compile the actor tests white-box against the host (provided: the fragment is pure test
         bytecode that resolves against the manifests-core host at runtime). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-core</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- the value vocabulary the tests speak (ManifestExplodeRequest/Result, ManifestAnnotations) -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-contract</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- The seed-broker seam manifests-core imports (its SeedHandler reflectors name
         seed.broker.port; the reconcilers encode with the codec). On the test classpath so
         installImportClosureOf can stage them — the closure walk locates bundles by classpath, and
         without a provider of seed.broker.port the whole manifests-core graph fails to resolve. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The in-memory file system the render's tree lives on: the fixture seals a tree there, which
         also proves the bundle resolves in-container (installed through the fixture's closure). -->
    <dependency>
      <groupId>com.github.marschall</groupId>
      <artifactId>memoryfilesystem</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- the fragment's src/main entry names the in-container runner (JUnitLauncherCore/
         InContainerJUnitRunner) directly; provided — resolved through the manifests-core host. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>junit-launcher</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- victools-wrap on the test classpath so installImportClosureOf can install it: manifests-core
         (via seed-broker-shape's RecordSchemaProjector) imports com.github.victools.*, whose only
         exporter is this wrap bundle. Without it the whole synthesis graph fails to resolve. The
         jgiven-wrap treatment, for the shape engine (mirrors manifests-bdd-test). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>victools-wrap</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Jupiter, the engine, jgiven-junit5, junit-platform-launcher AND the DS test stack (felix.scr
         + the org.osgi.service.component / util.promise / util.function trio for withScr()) are all
         inherited from bundle-test-parent. -->

    <!-- osgi.core (test): the harness names framework types (Bundle, BundleContext) directly. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- the src/test harness boots Felix via JGivenTestkit.felix() and installs the JUnit + jGiven
         bundle worlds by classpath substring, so they must be on the TEST classpath. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>scenario-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>jgiven-wrap</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- manifests-core's runtime graph, installed as bundles in-container by the probe so the host
         resolves. The cdk8s carrier (with its embedded flat closure) + the systemd-cdk8s-manifests
         fragment that rides it; the sibling ports; the pipeline engine + unitrepo-core; and the
         third-party OSGi bundles (jackson stack, snakeyaml, commons-*). All test-scope: the probe
         installFromClasspath()s them by BSN. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-cdk8s</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>netplan-contract</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>unitrepo-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The sops edge, installed in-container by its capability: RenderedSecretSealTest seals the
         exploded Secrets with the real SopsEncryptor it publishes. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>sops-edge</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- netplan-contract imports inet.ipaddr; installed in-container as its sole exporter bundle. -->
    <dependency>
      <groupId>com.github.seancfoley</groupId>
      <artifactId>ipaddress</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
