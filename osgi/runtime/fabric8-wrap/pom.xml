<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>fabric8-wrap</artifactId>
  <name>osgi/runtime/fabric8-wrap</name>
  <description>The fabric8 Kubernetes client (7.8.0) wrapped as a single first-class OSGi bundle — the
    Java kube-API carrier for a control-node seeder, living beside jgiven-wrap/victools-wrap in the
    runtime world. UNLIKE those two, fabric8 is NOT cleanly OSGi: its core jars (kubernetes-client,
    kubernetes-client-api, the httpclient backends) ship with NO Bundle-SymbolicName at all, and its
    ~21 kubernetes-model-* jars each RE-EXPORT the shared io.fabric8.kubernetes.api.builder (17x) and
    io.fabric8.kubernetes.model.annotation (11x) packages — a massive split-package the Felix
    resolver cannot wire (documented in fabric8io/kubernetes-client #822/#487/#3890). The OSGi-canonical
    answer for a non-bundle jar is the wrap (Karaf's `wrap:`), which here is lib:=true embedding: the
    whole fabric8 closure is nested onto THIS bundle's Bundle-ClassPath, so every fabric8 class loads
    from one classloader and the split-package dissolves. The wrap then EXPORTS io.fabric8.* once, a
    single clean surface cluster-edge imports. Only the JDK HttpClient backend is embedded (the
    default vertx backend, which drags Netty, is excluded). Everything fabric8 needs that is already
    a bundle stays IMPORTED: jackson + BouncyCastle (already staged for cluster-pki) + snakeyaml-engine
    (the one new transitive, staged from here); awaitility/commons-compress/sundr are optional (off the
    readiness path).</description>

  <dependencies>
    <!-- The fabric8 closure to embed. provided: on the bnd classpath so -includeresource nests the
         jars (lib:=true) and bnd computes the import surface, but NOT propagated to seed-outcluster — so
         the raw kubernetes-model-* bundles are never staged separately (which would resurrect the
         split-package). The vertx backend is excluded so Netty never reaches the classpath; the JDK
         backend is embedded instead. -->
    <dependency>
      <groupId>io.fabric8</groupId>
      <artifactId>kubernetes-client</artifactId>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>io.fabric8</groupId>
          <artifactId>kubernetes-httpclient-vertx</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.fabric8</groupId>
      <artifactId>kubernetes-httpclient-jdk</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- snakeyaml-engine: the kubeconfig YAML parser fabric8 binds. compile (NOT provided) so it
         propagates to seed-outcluster and is staged as its own bundle — the wrap IMPORTS it, does not
         embed it (it is already a first-class OSGi bundle). The only new transitive bundle fabric8
         needs; jackson + BouncyCastle are already staged by the manifests / cluster-pki graphs. -->
    <dependency>
      <groupId>org.snakeyaml</groupId>
      <artifactId>snakeyaml-engine</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <!-- -includeresource nests the fabric8 closure INTO this bundle jar, so analyze sees the whole
           kubernetes-model-* set + client-api + zjsonpatch + jackson + slf4j as "used undeclared".
           The wrap declares only the kubernetes-client umbrella (provided) and embeds its closure by
           design — the individual jars are not direct dependencies of this module (declaring them
           would resurrect the split-package this wrap exists to avoid). append keeps parent ignores. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <configuration>
          <ignoredUsedUndeclaredDependencies combine.children="append">
            <dep>com.fasterxml.jackson.core:jackson-core</dep>
            <dep>com.fasterxml.jackson.core:jackson-databind</dep>
            <dep>com.fasterxml.jackson.core:jackson-annotations</dep>
            <dep>com.fasterxml.jackson.dataformat:jackson-dataformat-yaml</dep>
            <dep>com.fasterxml.jackson.datatype:jackson-datatype-jsr310</dep>
            <dep>org.slf4j:slf4j-api</dep>
            <dep>io.fabric8:kubernetes-client-api</dep>
            <dep>io.fabric8:zjsonpatch</dep>
            <dep>io.fabric8:kubernetes-model-common</dep>
            <dep>io.fabric8:kubernetes-model-core</dep>
            <dep>io.fabric8:kubernetes-model-apps</dep>
            <dep>io.fabric8:kubernetes-model-apiextensions</dep>
            <dep>io.fabric8:kubernetes-model-admissionregistration</dep>
            <dep>io.fabric8:kubernetes-model-autoscaling</dep>
            <dep>io.fabric8:kubernetes-model-batch</dep>
            <dep>io.fabric8:kubernetes-model-certificates</dep>
            <dep>io.fabric8:kubernetes-model-coordination</dep>
            <dep>io.fabric8:kubernetes-model-discovery</dep>
            <dep>io.fabric8:kubernetes-model-events</dep>
            <dep>io.fabric8:kubernetes-model-extensions</dep>
            <dep>io.fabric8:kubernetes-model-flowcontrol</dep>
            <dep>io.fabric8:kubernetes-model-gatewayapi</dep>
            <dep>io.fabric8:kubernetes-model-metrics</dep>
            <dep>io.fabric8:kubernetes-model-networking</dep>
            <dep>io.fabric8:kubernetes-model-node</dep>
            <dep>io.fabric8:kubernetes-model-policy</dep>
            <dep>io.fabric8:kubernetes-model-rbac</dep>
            <dep>io.fabric8:kubernetes-model-resource</dep>
            <dep>io.fabric8:kubernetes-model-scheduling</dep>
            <dep>io.fabric8:kubernetes-model-storageclass</dep>
          </ignoredUsedUndeclaredDependencies>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
