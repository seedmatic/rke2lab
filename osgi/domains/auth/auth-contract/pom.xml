<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>auth-contract</artifactId>
  <name>osgi/domains/auth/auth-contract</name>
  <description>The auth domain's contract: the AuthTokenContact verb (resolve a short-lived credential for
    one AuthTokenSource — GitHub or FloxHub — by asking its CLI) and the flat AuthTokenSource enum.
    The auth-edge satisfies it by shelling `gh auth token` / `flox auth token`. type=contract:
    installed bundle-side and wired bundle-to-bundle, not system-exported — the host speaks only to
    the broker.</description>

  <dependencies>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
    </dependency>
    <!-- Cellar + Parcel: GithubAppTokens reads the sealed App credentials from the run's cellar.
         (This comment used to cite GithubToken + AuthCoordinate, the durable token seal — removed
         when the token became minted at the point of use; neither type exists any more.) -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- The App material's OWNER: GhAppCoordinate.GITHUB_APP + GithubAppCredentials, which
         GithubAppTokens reads and both mints take. Not a new coupling: auth-edge already imported
         these types to delegate to ghapp's GithubAppMinter, the only JWT signer — this lifts an
         existing edge-level link to the contract. No cycle: ghapp-contract depends only on
         domain-annotations + seed-broker-port. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ghapp-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-testkit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
