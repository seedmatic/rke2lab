<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>host-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../host-parent/pom.xml</relativePath>
  </parent>

  <artifactId>incus-ingress</artifactId>
  <name>host/pulumi/incus-ingress</name>
  <description>The Pulumi ACTUALISER of the incus ingress flow: the host-side com.pulumi graph
    (InstanceGrow) that ACTUALISES the InstanceGrowPlan the incus scion projected — declares
    Project→{Network,Profile,Image}→Instance and adopts pre-existing project/network via provider
    invokes (IncusImportLookup). Non-playable (com.pulumi.* is native + ServiceLoader), so it lives
    in the host world outside Felix, like pulumi-edge. It reads only the ingress CONTRACT
    (incus-ingress-contract: the InstanceGrowPlan it grows and the IngressConfig the run fills) — it
    depends on NO seed-master type, so the run delegates the grow to it without a cycle.</description>

  <dependencies>
    <!-- The ingress contract: the InstanceGrowPlan this actualises + the IngressConfig the run fills
         (dual-realm; consumed here through its flat copy). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>incus-ingress-contract</artifactId>
    </dependency>
    <!-- The generated Incus SDK: com.pulumi.incus.* — the Project/Network/Profile/Image/Instance
         resources InstanceGrow declares. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab.sdks</groupId>
      <artifactId>incus</artifactId>
    </dependency>
    <dependency>
      <groupId>com.pulumi</groupId>
      <artifactId>pulumi</artifactId>
    </dependency>
    <!-- local.Command: the post-instance beat poses the `node-base` image alias and GCs the leaked
         node-base images via the incus CLI (a runtimeInput the provider already shells out to),
         authenticating through the same configDir the provider uses. -->
    <dependency>
      <groupId>com.pulumi</groupId>
      <artifactId>command</artifactId>
    </dependency>
  </dependencies>
</project>
