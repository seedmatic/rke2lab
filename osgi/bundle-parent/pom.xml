<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>build-parent</artifactId>
    <version>0.0.0</version>
    <relativePath>../../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>bundle-parent</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>osgi/bundle-parent</name>
  <description>Parent of the OSGi bundles: carries the bnd build (manifest generation from
    annotations) and the jar manifestFile wiring as managed plugins. Only modules that ARE
    bundles inherit from here and opt in with a bare bnd-maven-plugin reference; pure test
    fixtures in the same space (testkit, tests) inherit build-parent instead, so they get no
    OSGi manifest. This is the "being a bundle is a per-module property" boundary.</description>

  <properties>
    <bnd.version>7.3.0</bnd.version>
    <!-- annotations.bnd is read by every bundle's build (its bnd.bnd -includes it) yet sits
         outside the bundle, where the build cache's src/ and bnd.bnd inputs never look: an edit
         here served every bundle its cached manifest. Named as a project input, so each bundle
         inheriting this pom keys its cache on it. -->
    <maven.build.cache.input.1>${maven.multiModuleProjectDirectory}/osgi/bundle-parent/annotations.bnd</maven.build.cache.input.1>
  </properties>

  <!-- Every bundle authors per-package @Version in package-info.java; bnd reads the annotation
       to stamp the Export-Package version. Compile-only (scope provided), inherited by all
       bundles so the annotation is uniformly available without per-module redeclaration. -->
  <dependencies>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.annotation.versioning</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>biz.aQute.bnd</groupId>
          <artifactId>bnd-maven-plugin</artifactId>
          <version>${bnd.version}</version>
          <!-- Shared bnd instructions are NOT single-sourced here: the bnd-maven-plugin <bnd>
               configuration is a silent, implicit inheritance a reader can't see from a module's
               own bnd.bnd. Each bundle instead -includes ./annotations.bnd EXPLICITLY (relative
               path, same convention as this pom's <relativePath>) — see that file for the
               compile-only annotation-import exclusions every bundle must apply. -->
          <executions>
            <execution>
              <goals>
                <goal>bnd-process</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <configuration>
            <archive>
              <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
            </archive>
          </configuration>
        </plugin>
        <!-- Semver enforcement: compares each bundle's just-built API against its last released
             baseline and FAILS if an exported package changed without the right @Version bump
             (additive→minor, breaking→major). failOnMissing=false bootstraps a SNAPSHOT-only
             repo with no release yet: no baseline → clean no-op, biting the moment a release is
             deliberately installed to freeze a reference. See the osgi-baseline-install-discipline
             memory note. -->
        <plugin>
          <groupId>biz.aQute.bnd</groupId>
          <artifactId>bnd-baseline-maven-plugin</artifactId>
          <version>${bnd.version}</version>
          <configuration>
            <failOnMissing>false</failOnMissing>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>baseline</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Activated for every bundle (all bundles inherit bundle-parent; non-bundle fixtures
           inherit build-parent, so they are not baselined). -->
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-baseline-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
