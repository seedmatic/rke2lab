<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>dataplan-contract</artifactId>
  <name>osgi/domains/dataplan/dataplan-contract</name>
  <description>The dataplan contract — the cluster ZFS dataset LAYOUT vocabulary the dataplan-bdd
    scion and its consumers (OpenebsZfsManifestsUnit, the static persist PV) depend on. Carries
    DataplanLayout (the canonical layout + its Dataset entries) plus the runbook-input wire-record
    and the domain coordinates the handlers speak. type=contract: installed bundle-side and wired
    bundle-to-bundle, not system-exported — the host speaks only to the broker. Versioned
    independently of the reactor GAV via per-package @Version (starts 1.0.0).</description>

  <dependencies>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
    </dependency>
    <!-- ClusterRole (MGMT/WRKLD): the persist tier is keyed by ROLE, because a host carries exactly
         one cluster per role and the checked-in projection ndh consumes is host-agnostic. The same
         direction netplan-contract already takes for the same reason — the role vocabulary is owned
         by manifests-contract, never re-defined (a second roster is a second owner). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-contract</artifactId>
    </dependency>
    <!-- The seed-broker seam: DataplanRunbookInput carries @SeedContract("runbook") + @Amendment(SOIL)
         and DataplanCoordinate holds the Amend/Shape/Runbook meta-coordinates. Like netplan-contract. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
