<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>cluster-pki-bdd</artifactId>
  <name>osgi/domains/cluster-pki/cluster-pki-bdd</name>
  <description>The cluster-pki seal scion: the in-container @SeedScenario the host sows once per
    cluster (the crossing before provisioning). It is idempotent on a cellar hit (a prior grow's
    bundle keeps the CA stable across re-grows), drives ClusterSeal (BouncyCastle generate + sops
    seal + ssh-to-age), and files ClusterCaBundle (PLAIN) + ClusterAgeKey (SEALED) at the
    ClusterPkiCoordinate for the host GROW to pose over devlxd. ClusterPkiRunbookHandler is the
    broker's host-to-scion door; the scion takes NO input (it reads keys.yaml / .sops.yaml
    in-container), so the handler's seedFrom is a no-op.</description>

  <dependencies>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>cluster-pki-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>cluster-pki-core</artifactId>
    </dependency>
    <!-- SshToAgeConverter — @OsgiService-injected, handed to ClusterSeal (instance-passing). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>manifests-contract</artifactId>
    </dependency>
    <!-- NdhKeystoreReader — @OsgiService-injected, handed to ClusterSeal (instance-passing). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ndh-contract</artifactId>
    </dependency>
    <!-- Cellar/Parcel/SeedCoordinate/RunbookCoordinate/SeedHandler/Sensitivity/SeedEnvelope. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- SeedCodec + AmendmentBinder: the seal's runbook handler decodes ClusterPkiSealInput and the
         amend reflector binds the WORKLOAD_TARGETS role onto it. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>
    <!-- GenericRunbookHandler, ScenarioPlayer, @SeedScenario, CellarReceiver, ScenarioCellar, OsgiService. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- bnd-consumed: @Component generates OSGI-INF/*.xml + the Service-Component header. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
