<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>incus-bdd</artifactId>
  <name>osgi/domains/incus/incus-bdd</name>
  <description>The incus domain's provisioning SCENARIO — a production jGiven scenario played
    IN-CONTAINER by the seeding engine, not a test. It builds the seed image (ImageBuilder) — or, under
    a closed RunGate, plans it inert — then probes the launched instance's reachability
    (IncusInstanceContact), and consults the doctor (ConsultingService, doctor-contract) on a build or
    exec failure — all domain vocabulary, zero host/Pulumi type. It lives here, not in an incus-core
    (there is none: the heavy Pulumi-bound provisioning stays host-side), because it needs only the
    incus-contract seam. A type=model embeddable bundle whose scenario class is non-exported: the
    launcher plays it by class-selection, the host grafts its ScenarioModel — the class never crosses a
    realm.</description>

  <dependencies>
    <!-- The incus domain's contract: the ImageBuilder + IncusInstanceContact verbs the scenario's DSL
         speaks, plus the flat request records it addresses them with. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>incus-contract</artifactId>
    </dependency>
    <!-- The incus domain's dual-realm host face: the scion assembles the InstanceGrowPlan (the flat
         views the host GROW consumes) and stores it at INSTANCE_GROW_PLAN. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>incus-ingress-contract</artifactId>
    </dependency>
    <!-- The incus domain's in-container logic: BootstrapPaths (the scion reconstructs the
         provisioning topology from the worktree scalars and derives the per-cluster render path) +
         GrowNetworkResolver / GrowPlanAssembler (assemble the flat grow views from the netplan
         blueprint). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>incus-core</artifactId>
    </dependency>
    <!-- The netplan synthesis service the scion resolves to derive the network blueprint it projects
         into the grow plan (the_network_is_resolved). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>netplan-contract</artifactId>
    </dependency>
    <!-- The worktree domain's jgit-free contract: the scion fetches the harvested WorktreeFacts
         (WorktreeCoordinate.FACTS) from the cellar to read the worktree ROOT it anchors every path
         on — replacing the worktreeRoot scalar the host used to sow and the deleted
         GitProvenanceReader. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>worktree-contract</artifactId>
    </dependency>
    <!-- The doctor's consult seam: the scenario consults the doctor itself on a build/exec failure. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>doctor-core</artifactId>
    </dependency>
    <!-- The frontier vocabulary: the RunGate the scion consults, the SeedEnvelope it consults the
         doctor with and carries the consultation back on. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- Also carries AmendmentBinder: IncusAmendReflector binds the neutral SOIL role onto
         IncusRunbookInput without naming the field. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>
    <!-- jGiven as compile deps: the scenario IS jGiven Stages. At runtime these packages resolve to
         the jgiven-wrap bundle, pulled into the live world by this bundle's import closure. -->
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-core</artifactId>
    </dependency>
    <!-- The scenario's main code drives the embedded launcher and declares Jupiter extensions
         directly (bdd-as-engine), so these are compile deps here, not only test. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <!-- The scenario's main code parses jackson and asserts on doctor verdicts directly. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>doctor-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
    </dependency>
    <!-- The neutral in-container runner the front-door calls to play the scenario inside Felix. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
    </dependency>
    <!-- osgi.core: the scenario resolves its collaborators from the BundleContext (both contacts,
         the RunGate, the doctor). -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- bnd-consumed construction annotations: IncusRunbookHandler (@Component) publishes the runbook
         SeedHandler that plays this bundle's scenario in-container. provided — SCR supplies the
         runtime, bnd only needs them to emit the descriptor + the extender requirement. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
