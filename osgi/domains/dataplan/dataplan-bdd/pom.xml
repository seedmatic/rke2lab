<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>dataplan-bdd</artifactId>
  <name>osgi/domains/dataplan/dataplan-bdd</name>
  <description>The dataplan domain's layout-export SCENARIO — a production jGiven scenario played
    IN-CONTAINER by the seeding engine, not a test. The dataplan sibling of netplan-bdd: it
    SYNTHESISES + MATERIALISES a file (dataplan.json) rather than probing a live system. The layout
    (DataplanLayout, a dataplan-contract record) is a bundle-realm type that cannot cross the host
    frontier as a TYPE — so the export is produced HERE, where the type lives, and reaped by the
    host as JSON (the plan CLI reads it back). DataplanScenario derives the canonical layout;
    DataplanRunbookHandler serves the runbook coordinate that plays it; DataplanAmendReflector
    reconciles the SOIL amendment onto DataplanRunbookInput at the amend door. A type=model
    embeddable bundle whose scenario class is non-exported.</description>

  <dependencies>
    <!-- The dataplan contract: the layout record (the export derivation builds it), the
         runbook-input wire-record + the domain coordinates the handlers speak. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>dataplan-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The frontier vocabulary: the SeedEnvelope the trigger arrives on + the runbook is reaped on,
         the AmendmentAssembler the reflector gathers ambient roles from, the Amendment roles. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- The codec (SeedCodec, AmendmentBinder) the reflector reconciles with + the scion serialises
         the layout JSON through. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>
    <!-- jGiven as a compile dep: the scenario IS jGiven Stages. At runtime these packages resolve to
         the jgiven-wrap bundle, pulled into the live world by this bundle's import closure. -->
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-core</artifactId>
    </dependency>
    <!-- The scenario declares Jupiter extensions (@RegisterExtension, @Test), so these are compile
         deps here, not only test. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
    </dependency>
    <!-- The in-container runner primitives (GenericRunbookHandler, ScenarioPlayer, InputReceiver,
         ScenarioInputSeed) the handler + scenario extend/use. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
    </dependency>
    <!-- The scion serialises the layout to JSON (SeedCodec returns a String; the JsonNode type the
         amend reflector names is jackson-databind). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- osgi.core: contributed @Component activation + the BundleContext the engine carries. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- bnd-consumed construction annotations: DataplanRunbookHandler + DataplanAmendReflector
         (@Component) publish the SeedHandlers. provided — SCR supplies the runtime. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- checker-qual: @MonotonicNonNull for the scenario's set-once input. Analysis-only. -->
    <dependency>
      <groupId>org.checkerframework</groupId>
      <artifactId>checker-qual</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
