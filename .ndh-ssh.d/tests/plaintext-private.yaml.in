# Must FAIL the schema, for ONE reason only: a private key in CLEAR in the committed file. The check
# ssh-keys-schema writes the armour in place of @BEGIN@ / @END@ at run time, so no file in the tree,
# nor the store copy of it, carries a private key's armour.
# A valid sops envelope around unencrypted keys is how eight privates were published in 2026-08.
authorities:
  test-ca:
    type: ssh-ed25519
    slots:
      26-10-01:
        public: AAAAC3NzaC1lZDI1NTE5AAAAIOneFixtureBlobOneFixtureBlobOneFixtureBlob
        private: |
          @BEGIN@
          not-a-real-key-only-its-shape
          @END@
keys: {}
