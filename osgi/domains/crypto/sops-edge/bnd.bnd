-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.sops.edge
# Self-declares this jar as an embeddable EDGE bundle (scanned + installed under META-INF/bundles by
# the io.seedmatic.rke2lab.embed capability). type=edge: the system's door
# toward an external tool (sops), not in-domain logic.
Provide-Capability: io.seedmatic.rke2lab.embed; type=edge; edge=sops
