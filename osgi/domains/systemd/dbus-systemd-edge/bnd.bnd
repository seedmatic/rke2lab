-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.dbus.systemd.edge
# Self-declares this jar as an embeddable EDGE bundle (scanned + installed under META-INF/bundles by
# the same io.seedmatic.rke2lab.embed capability as the other carriers). See sops-edge.
Provide-Capability: io.seedmatic.rke2lab.embed; type=edge; edge=dbus-systemd

# Wildcard (overriding bnd's auto per-component value) so a test fragment attached to this edge can
# contribute its own OSGI-INF/*.xml: findEntries spans attached fragments, so this catches BOTH this
# edge's own DbusSystemdProbe descriptor AND a fragment-contributed fake. The same host-of-
# contributions gesture doctor-core makes — a fragment's Service-Component is never merged into the
# host manifest (bundle.getHeaders() ignores fragment headers), so the host must name the wildcard.
Service-Component: OSGI-INF/*.xml

# Embed the dbus-java stack as WHOLE nested jars (no @ — the jars stay intact); the lib:=true
# directive nests each jar AND adds it to this bundle's Bundle-ClassPath. The transport ServiceLoader
# and the TcpTransportProvider it discovers then resolve through THIS bundle's classloader, each jar
# keeping its own META-INF/services intact — no SPI-Fly, no system leak, no merged service files.
-includeresource: \
  dbus-java-core-*.jar;lib:=true, \
  dbus-java-transport-tcp-*.jar;lib:=true, \
  java-systemd-*.jar;lib:=true

